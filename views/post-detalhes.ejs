<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes da Postagem - Portal da Inclusão</title>

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .container-detalhes { max-width: 700px; margin: 30px auto; }
        
        /* Card Principal */
        .post-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08 );
            overflow: hidden;
            margin-bottom: 20px;
        }
        .post-header { padding: 15px; display: flex; align-items: center; gap: 12px; }
        .avatar { width: 45px; height: 45px; border-radius: 50%; object-fit: cover; background: #eee; }
        .user-info h6 { margin: 0; font-weight: bold; color: #1c1e21; }
        .user-info span { font-size: 12px; color: #65676b; }
        
        .post-content { padding: 0 15px 15px 15px; font-size: 15px; color: #1c1e21; line-height: 1.5; }
        .post-image { width: 100%; max-height: 500px; object-fit: contain; background: #f8f9fa; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
        
        .post-actions { padding: 10px 15px; display: flex; border-top: 1px solid #eee; gap: 20px; }
        .action-btn { background: none; border: none; color: #65676b; font-weight: 600; display: flex; align-items: center; gap: 6px; cursor: pointer; transition: 0.2s; padding: 8px 12px; border-radius: 6px; }
        .action-btn:hover { background: #f2f2f2; color: #007bff; }
        .action-btn.active { color: #e41e3f; }

        /* Seção de Comentários */
        .comments-section { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .comment-item { display: flex; gap: 12px; margin-bottom: 20px; }
        .comment-bubble { background: #f0f2f5; padding: 10px 15px; border-radius: 18px; flex: 1; }
        .comment-bubble h6 { margin: 0; font-size: 13px; font-weight: bold; color: #1c1e21; }
        .comment-bubble p { margin: 4px 0 0 0; font-size: 14px; color: #1c1e21; }
        
        /* Formulário de Comentário */
        .comment-form { display: flex; gap: 10px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee; }
        .comment-input { flex: 1; border: 1px solid #ddd; border-radius: 20px; padding: 10px 18px; outline: none; transition: 0.2s; background: #f0f2f5; }
        .comment-input:focus { border-color: #007bff; background: white; }
        .btn-send { background: #007bff; color: white; border: none; border-radius: 50%; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; transition: 0.2s; cursor: pointer; }
        .btn-send:hover { background: #0056b3; transform: scale(1.05); }
    </style>
</head>
<body>

<header>
    <%- include('partials/navbar') %> 
</header>

<main class="container-detalhes">
    <!-- Card do Post Original -->
    <div class="post-card">
        <div class="post-header">
            <img src="<%= postagem.foto_perfil || '/images/default-avatar.png' %>" class="avatar" alt="Avatar">
            <div class="user-info">
                <h6><%= postagem.login %></h6>
                <span><%= new Date(postagem.data_postagem).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
            </div>
        </div>
        
        <div class="post-content">
            <p><%= postagem.comentarios %></p>
        </div>

        <% if (postagem.fotos) { %>
            <img src="data:image/jpeg;base64, <%= postagem.fotos.toString('base64') %>" class="post-image" alt="Imagem do post">
        <% } %>

        <div class="post-actions">
            <button class="action-btn <%= postagem.usuario_curtiu ? 'active' : '' %>" onclick="curtirPost(<%= postagem.id %>)">
                <i class="fa-<%= postagem.usuario_curtiu ? 'solid' : 'regular' %> fa-heart"></i> 
                <span><%= postagem.total_curtidas %></span>
            </button>
            <button class="action-btn" onclick="document.getElementById('texto-comentario').focus()">
                <i class="fa-regular fa-comment"></i> Comentar
            </button>
            <button class="action-btn" onclick="denunciarPost(<%= postagem.id %>)">
                <i class="fa-regular fa-flag"></i> Denunciar
            </button>
        </div>
    </div>

    <!-- Seção de Comentários -->
    <div class="comments-section">
        <h5 class="mb-4">Comentários</h5>
        
        <div id="lista-comentarios">
            <% if (comentarios && comentarios.length > 0) { %>
                <% comentarios.forEach(comentario => { %>
                    <div class="comment-item">
                        <img src="<%= comentario.foto_perfil || '/images/default-avatar.png' %>" class="avatar" style="width: 35px; height: 35px;">
                        <div class="comment-bubble">
                            <h6><%= comentario.login %></h6>
                            <p><%= comentario.texto_comentario %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-4">
                    <i class="fa-regular fa-comments fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Nenhum comentário ainda. Seja o primeiro a responder!</p>
                </div>
            <% } %>
        </div>

        <!-- Formulário para comentar -->
        <form id="form-comentario" class="comment-form">
            <input type="text" id="texto-comentario" class="comment-input" placeholder="Escreva uma resposta..." required>
            <button type="submit" class="btn-send">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>
    </div>
</main>

<script>
    // Função para Curtir
    function curtirPost(id) {
        fetch(`/responsavel/curtir/${id}`, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            if (data.sucesso) window.location.reload();
        });
    }

    // Função para Denunciar
    function denunciarPost(id) {
        const motivo = prompt("Por que deseja denunciar esta postagem?");
        if (motivo) {
            fetch(`/responsavel/denunciar/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ motivo })
            })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) alert("Denúncia enviada com sucesso.");
            });
        }
    }

    // Enviar Comentário
    document.getElementById('form-comentario').addEventListener('submit', function(e) {
        e.preventDefault();
        const texto = document.getElementById('texto-comentario').value;
        const postId = <%= postagem.id %>;

        fetch(`/responsavel/comentar/${postId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ texto })
        })
        .then(res => res.json())
        .then(data => {
            if (data.sucesso) {
                window.location.reload();
            } else {
                alert("Erro ao comentar.");
            }
        });
    });
</script>

</body>
</html>
