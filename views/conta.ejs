<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conta - Portal do Responsável</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
    <link rel="stylesheet" href="/stylesheets/conta.css">
</head>
<body>
    <header>
         <%- include('partials/menu' ) %>
         <%- include('partials/navbar') %> 
    </header>

    <main class="main-content">
        <% if (!editMode) { %>
            <!-- PERFIL TOPO -->
            <section class="profile-section" style="justify-content: center; text-align: center; flex-direction: column; align-items: center; margin-bottom: 40px;">
                <div class="profile-avatar" style="margin: 0 auto 20px;">
                    <img src="<%= usuario.foto_perfil || '/images/avatar-padrao.png' %>" alt="Foto">
                </div>
                <div class="profile-info">
                    <h2 style="justify-content: center;"><%= usuario.login %> <a href="/conta/editar" style="color: #888;"><i class="bi bi-pencil"></i></a></h2>
                    <p style="padding: 0; display: inline-block;"><%= usuario.bio || 'Adicione uma biografia.' %></p>
                </div>
            </section>

            <!-- ABAS CENTRALIZADAS -->
            <div class="section-divider">
                <span id="tab-info" class="active">Informações</span>
                <span id="tab-config">Configurações</span>
            </div>

            <!-- SEÇÃO INFORMAÇÕES (PADRONIZADA) -->
            <section id="sec-info" class="content-section active">
                <div class="custom-card">
                    <div class="card-info">
                        <span class="label">Senha de Acesso</span>
                        <p id="txt-senha" class="password-display">************</p>
                    </div>
                    <i id="btn-olho" class="bi bi-eye" style="cursor: pointer; font-size: 22px; color: #34495e;"></i>
                </div>

                <div class="custom-card">
                    <div class="card-info">
                        <span class="label">Endereço de E-mail</span>
                        <p><%= usuario.email %></p>
                    </div>
                    <i class="bi bi-envelope" style="color: #888; font-size: 20px;"></i>
                </div>

                <div class="custom-card">
                    <div class="card-info">
                        <span class="label">Data de Nascimento</span>
                        <p><%= usuario.data_nascimento ? new Date(usuario.data_nascimento).toLocaleDateString('pt-BR', {timeZone: 'UTC'}) : 'Não informado' %></p>
                    </div>
                    <i class="bi bi-calendar-event" style="color: #888; font-size: 20px;"></i>
                </div>

                <div class="custom-card">
                    <div class="card-info">
                        <span class="label">Gênero</span>
                        <p><%= usuario.genero || 'Não informado' %></p>
                    </div>
                    <i class="bi bi-person-arms-up" style="color: #888; font-size: 20px;"></i>
                </div>
            </section>

            <!-- SEÇÃO CONFIGURAÇÕES -->
            <section id="sec-config" class="content-section">
                <div class="custom-card">
                    <div class="card-info">
                        <h4>Notificações</h4>
                        <p>Receber avisos no e-mail</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" id="sw-notif" <%= usuario.notificacoes_ativas ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="custom-card">
                    <div class="card-info">
                        <h4>Segurança</h4>
                        <p>Restaurar senha por e-mail</p>
                    </div>
                    <button id="btn-restore" class="btn-action">Restaurar</button>
                </div>

                <div class="custom-card">
                    <div class="card-info">
                        <h4>Sessão</h4>
                        <p>Sair da sua conta neste dispositivo</p>
                    </div>
                    <button id="btn-logout" class="btn-action">Sair</button>
                </div>

                <div class="custom-card" style="border-left: 5px solid #e74c3c;">
                    <div class="card-info">
                        <h4 style="color: #e74c3c;">Conta</h4>
                        <p>Excluir dados permanentemente</p>
                    </div>
                    <button id="btn-del" class="btn-action danger">Excluir</button>
                </div>
            </section>

            <!-- SEÇÃO "SUAS PUBLICAÇÕES" -->
            <h3 class="publicacoes-titulo">Suas publicações</h3>

            <section class="publicacoes-grid">
                <% if (publicacoes && publicacoes.length > 0) { %>
                    <% publicacoes.forEach(publicacao => { %>
                        <div class="publicacao-card <%= publicacao.oculta ? 'esta-oculta' : '' %>" id="publicacao-card-<%= publicacao.id %>">
                            <% if (publicacao.oculta) { %>
                                <div class="publicacao-tag-oculta">Oculta</div>
                            <% } %>
                            <div class="publicacao-linha">
                                <div class="publicacao-imagem-wrapper">
                                    <% if (publicacao.fotos) { %>
                                        <img src="data:image/jpeg;base64,<%= publicacao.fotos.toString('base64') %>" alt="Publicação">
                                    <% } %>

                                    <button type="button" class="publicacao-btn-menu" data-id="<%= publicacao.id %>" title="Mais opções">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                </div>

                                <div class="publicacao-menu" id="publicacao-menu-<%= publicacao.id %>">
                                    <button type="button" class="btn-excluir-publicacao" data-id="<%= publicacao.id %>">Excluir</button>
                                    <button type="button" class="btn-editar-publicacao" data-id="<%= publicacao.id %>">Editar</button>
                                    <button type="button" class="btn-ocultar-publicacao" data-id="<%= publicacao.id %>" data-oculta="<%= publicacao.oculta ? '1' : '0' %>">
                                        <%= publicacao.oculta ? 'Tornar visível' : 'Ocultar' %>
                                    </button>
                                    <button type="button" class="btn-fechar-menu" data-id="<%= publicacao.id %>">Fechar</button>
                                </div>
                            </div>

                            <div class="publicacao-info">
                                <span><i class="bi bi-chat"></i> <%= publicacao.total_comentarios || 0 %></span>
                                <span><i class="bi bi-heart-fill"></i> <%= publicacao.total_curtidas || 0 %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="grid-column: 1 / -1; text-align: center; color: #666;">Nenhuma publicação ainda.</p>
                <% } %>
            </section>

        <% } else { %>
            <!-- MODO EDIÇÃO (MANTIDO) -->
            <form action="/conta/editar" method="POST" enctype="multipart/form-data">
                <section class="profile-section">
                    <div class="profile-avatar">
                        <img src="<%= usuario.foto_perfil || '/images/avatar-padrao.png' %>" alt="Foto">
                        <div class="upload-btn-wrapper">
                            <button type="button" class="btn-upload"><i class="bi bi-camera"></i></button>
                            <input type="file" name="foto_perfil" accept="image/*" />
                        </div>
                    </div>
                    <div class="profile-info" style="flex: 1;">
                        <label>Nome de Usuário:</label>
                        <input type="text" name="login" class="edit-input" value="<%= usuario.login %>" required>
                        <label>Email:</label>
                        <input type="email" class="edit-input" value="<%= usuario.email %>" readonly style="background: #f4f4f4;">
                        <div style="display: flex; gap: 20px;">
                            <div style="flex: 1;"><label>Nascimento:</label><input type="date" name="data_nascimento" class="edit-input" value="<%= usuario.data_nascimento ? new Date(usuario.data_nascimento).toISOString().split('T')[0] : '' %>"></div>
                            <div style="flex: 1;"><label>Gênero:</label><select name="genero" class="edit-input"><option value="">Selecione...</option><option value="Masculino" <%= usuario.genero === 'Masculino' ? 'selected' : '' %>>Masculino</option><option value="Feminino" <%= usuario.genero === 'Feminino' ? 'selected' : '' %>>Feminino</option><option value="Outro" <%= usuario.genero === 'Outro' ? 'selected' : '' %>>Outro</option></select></div>
                        </div>
                        <label>Biografia:</label>
                        <textarea name="bio" class="edit-input" rows="4"><%= usuario.bio %></textarea>
                        <div style="display: flex; gap: 15px; margin-top: 15px;">
                            <button type="submit" class="btn-save">Salvar Alterações</button>
                            <a href="/conta" class="btn-cancel">Cancelar</a>
                        </div>
                    </div>
                </section>
            </form>
        <% } %>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Alternar Abas
            const tInfo = document.getElementById('tab-info');
            const tConf = document.getElementById('tab-config');
            const sInfo = document.getElementById('sec-info');
            const sConf = document.getElementById('sec-config');

            if(tInfo && tConf) {
                tInfo.onclick = () => { tInfo.classList.add('active'); tConf.classList.remove('active'); sInfo.classList.add('active'); sConf.classList.remove('active'); };
                tConf.onclick = () => { tConf.classList.add('active'); tInfo.classList.remove('active'); sConf.classList.add('active'); sInfo.classList.remove('active'); };
            }

            // Olhinho da Senha Real
            const btnOlho = document.getElementById('btn-olho');
            const txtSenha = document.getElementById('txt-senha');
            let isVis = false;
            if(btnOlho) {
                btnOlho.onclick = () => {
                    isVis = !isVis;
                    if(isVis) {
                        txtSenha.innerText = '<%= usuario.senha %>';
                        btnOlho.classList.replace('bi-eye', 'bi-eye-slash');
                    } else {
                        txtSenha.innerText = '************';
                        btnOlho.classList.replace('bi-eye-slash', 'bi-eye');
                    }
                };
            }

            // Notificações AJAX
            const swNotif = document.getElementById('sw-notif');
            if(swNotif) {
                swNotif.onchange = function() {
                    fetch('/conta/notificacoes', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ ativo: this.checked })
                    });
                };
            }

            // Restaurar Senha (Simulação)
            const btnRest = document.getElementById('btn-restore');
            if(btnRest) {
                btnRest.onclick = () => {
                    if(confirm('Enviar link de restauração para <%= usuario.email %>?')) {
                        fetch('/conta/redefinir-senha', { method: 'POST' })
                        .then(r => r.json()).then(d => alert(d.mensagem));
                    }
                };
            }

            // Sair da Conta (Logout)
            const btnLogout = document.getElementById('btn-logout');
            if(btnLogout) {
                btnLogout.onclick = () => {
                    if(confirm('Tem certeza que deseja sair da sua conta?')) {
                        window.location.href = '/conta/logout';
                    }
                };
            }

            // Excluir Conta
            const btnDel = document.getElementById('btn-del');
            if(btnDel) {
                btnDel.onclick = () => {
                    if(confirm('Excluir conta permanentemente?')) {
                        const s = prompt('Confirme sua senha:');
                        if(s) fetch('/conta/deletar', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ senha: s })
                        }).then(r => r.json()).then(d => { if(d.sucesso) window.location.href='/login'; else alert('Senha incorreta'); });
                    }
                };
            }

            /* ---------- Menu de opções de cada publicação (Excluir / Editar / Ocultar / Fechar) ---------- */
            document.querySelectorAll('.publicacao-btn-menu').forEach(function(botao) {
                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');
                    const menu = document.getElementById('publicacao-menu-' + id);
                    const card = document.getElementById('publicacao-card-' + id);
                    menu.classList.toggle('aberto');
                    card.classList.toggle('menu-aberto');
                });
            });

            document.querySelectorAll('.btn-fechar-menu').forEach(function(botao) {
                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');
                    document.getElementById('publicacao-menu-' + id).classList.remove('aberto');
                    document.getElementById('publicacao-card-' + id).classList.remove('menu-aberto');
                });
            });

            document.querySelectorAll('.btn-excluir-publicacao').forEach(function(botao) {
                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');
                    if (!confirm('Excluir esta publicação permanentemente?')) return;

                    fetch('/conta/publicacoes/' + id, { method: 'DELETE' })
                        .then(r => r.json())
                        .then(d => {
                            if (d.sucesso) {
                                document.getElementById('publicacao-card-' + id).remove();
                            } else {
                                alert('Não foi possível excluir a publicação.');
                            }
                        })
                        .catch(() => alert('Erro de conexão ao excluir.'));
                });
            });

            document.querySelectorAll('.btn-editar-publicacao').forEach(function(botao) {
                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');
                    window.location.href = '/conta/publicacoes/' + id + '/editar';
                });
            });

            document.querySelectorAll('.btn-ocultar-publicacao').forEach(function(botao) {
                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');

                    fetch('/conta/publicacoes/' + id + '/ocultar', { method: 'POST' })
                        .then(r => r.json())
                        .then(d => {
                            if (!d.sucesso) {
                                alert('Não foi possível atualizar a publicação.');
                                return;
                            }

                            const card = document.getElementById('publicacao-card-' + id);
                            const menu = document.getElementById('publicacao-menu-' + id);

                            card.classList.toggle('esta-oculta', d.oculta);
                            botao.textContent = d.oculta ? 'Tornar visível' : 'Ocultar';

                            // Adiciona ou remove a etiqueta "Oculta" no canto do card
                            let tag = card.querySelector('.publicacao-tag-oculta');
                            if (d.oculta && !tag) {
                                tag = document.createElement('div');
                                tag.className = 'publicacao-tag-oculta';
                                tag.textContent = 'Oculta';
                                card.insertBefore(tag, card.firstChild);
                            } else if (!d.oculta && tag) {
                                tag.remove();
                            }

                            menu.classList.remove('aberto');
                            card.classList.remove('menu-aberto');
                        })
                        .catch(() => alert('Erro de conexão ao atualizar a publicação.'));
                });
            });
        });
    </script>
    <%- include('partials/modal-contato') %> 
    <%- include('partials/modal-feedback') %> 
    <%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="javascripts/menu.js"></script>
    <script src="javascripts/modal-contato.js"></script>
    <script src="javascripts/modal-feedback.js"></script>
</body>
</html>
