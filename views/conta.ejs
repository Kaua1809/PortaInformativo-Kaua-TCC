<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conta - Portal do Responsável</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header>
         <%- include('partials/menu' ) %>
         <%- include('partials/navbar') %> 
    </header>

    <main class="main-content">
        <% if (!editMode) { %>
            <section class="profile-section">
                <div class="profile-avatar">
                    <img src="<%= usuario.foto_perfil || '/images/avatar-padrao.png' %>" alt="Foto">
                </div>
                <div class="profile-info">
                    <h2><%= usuario.login %> <a href="/conta/editar" style="color: #888;"><i class="bi bi-pencil"></i></a></h2>
                    <p class="bio-text"><%= usuario.bio || 'Adicione uma biografia.' %></p>
                </div>
            </section>

            <div class="section-divider">
                <span>Informações pessoais</span>
                <span>Configurações</span>
            </div>

            <section class="info-grid">
                <div>
                    <div class="info-item"><label>Senha:</label> <span>************ <i class="bi bi-eye"></i></span></div>
                    <div class="info-item"><label>Email:</label> <a href="mailto:<%= usuario.email %>"><%= usuario.email %></a></div>
                    <div class="info-item"><label>Data de nascimento:</label> <span>18/09/2008</span></div>
                    <div class="info-item"><label>Gênero:</label> <span>Masculino</span></div>
                </div>
            </section>
        <% } else { %>
            <form action="/conta/editar" method="POST" enctype="multipart/form-data">
                <section class="profile-section">
                    <div class="profile-avatar">
                        <img src="<%= usuario.foto_perfil || '/images/avatar-padrao.png' %>" alt="Foto">
                        <div class="upload-btn-wrapper">
                            <button type="button" class="btn-upload"><i class="bi bi-camera"></i></button>
                            <input type="file" name="foto_perfil" accept="image/*" />
                        </div>
                    </div>
                    <div class="profile-info" style="flex: 1;">
                        <label>Nome de Usuário:</label>
                        <input type="text" name="login" class="edit-input" value="<%= usuario.login %>" required>
                        <label>Biografia:</label>
                        <textarea name="bio" class="edit-input" rows="6"><%= usuario.bio %></textarea>
                        <div style="display: flex; gap: 15px;">
                            <button type="submit" class="btn-save">Salvar Alterações</button>
                            <a href="/conta" class="btn-cancel">Cancelar</a>
                        </div>
                    </div>
                </section>
            </form>
        <% } %>
    </main>
    <%- include('partials/modal-contato') %> 
    <%- include('partials/modal-feedback') %> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
     <script src="javascripts/menu.js"></script>
    <script src="javascripts/modal-contato.js"></script>
    <script src="javascripts/modal-feedback.js"></script>
</body>
</html>
