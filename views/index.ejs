<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal IncluaNeuro</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
</head>
<body>
    <header>
         <%- include('partials/menu') %>
         <%- include('partials/navbar') %> 
    </header>
    <main>
        <article>

         <div id="carouselExampleFade" class="carousel slide carousel-fade" data-bs-ride="carousel">
  
  <div class="carousel-inner">

    <!-- Slide 1 -->
    <div class="carousel-item active">
      <img class="carrosel" src="/images/deficiencia.png" alt="Imagem de uma mulher sentada em uma cadeira de rodas">
      <div class="overlay"></div>
      <div class="carousel-caption">
        <h3>Bem-vindo ao IncluaNeuro</h3>
        <p>Um espaço dedicado à informação sobre hidrocefalia e mielomeningocele</p>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-item">
      <img class="carrosel" src="/images/fotonot1.png" alt="Imagem de uma menina com síndrome de down">
      <div class="overlay"></div>
      <div class="carousel-caption">
        <h3>Informação que acolhe</h3>
        <p>Conteúdo pensado para famílias, cuidadores e profissionais</p>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-item">
      <img class="carrosel" src="/images/deficiencia-carro.jpg" alt="imagem de um homem sentado em uma cadeira de rodas">
      <div class="overlay"></div>
      <div class="carousel-caption">
        <h3>Acessibilidade e apoio</h3>
        <p>Conheça, entenda e encontre suporte em cada etapa</p>
      </div>
    </div>

  </div>

  <!-- Botões -->
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>

</div>

        <div class="faixa-titulo">
        <h2>SOBRE</h2>
        </div>

        <!-- Texto curto sobre o que o portal aborda -->
        <div class="apresentacao-portal">
            <p>
                O portal IncluaNeuro reúne informações confiáveis e acessíveis sobre hidrocefalia
                e mielomeningocele, com o objetivo de apoiar famílias, cuidadores e profissionais
                no entendimento dessas condições, seus tratamentos e formas de cuidado no dia a dia.
            </p>
        </div>

        <!-- Cards de acesso às condições -->
        <div class="area-condicoes">
            <div class="condicoes-grid">
                <a href="/hidrocefalia" class="card-condicao">
                    <img src="/images/Amputação.jpg" alt="Ilustração representando hidrocefalia">
                    <div class="card-condicao-texto">
                        <h3>Hidrocefalia</h3>
                        <p>Entenda o que é, causas, tratamentos e cuidados relacionados à hidrocefalia.</p>
                    </div>
                </a>

                <a href="/mielomeningocele" class="card-condicao">
                    <img src="/images/mielomeningocele.png" alt="Ilustração representando mielomeningocele">
                    <div class="card-condicao-texto">
                        <h3>Mielomeningocele</h3>
                        <p>Saiba mais sobre a mielomeningocele, seu diagnóstico e acompanhamento.</p>
                    </div>
                </a>
            </div>
        </div>

        <div id="noticias">
        <h2>NOTÍCIAS</h2>
        </div>

        <% if (usuarioLogado && usuarioLogado.is_admin) { %>
            <div class="area-btn-nova-noticia">
                <a href="/noticias/nova/criar" class="btn-nova-noticia" title="Criar nova notícia">+</a>
            </div>
        <% } %>

        <% if (noticias && noticias.length > 0) { %>
            <% noticias.forEach(function(noticia) { %>
                <div class="card">
                    <a href="/noticias/<%= noticia.id %>">
                        <% if (noticia.foto) { %>
                            <img src="data:image/jpeg;base64,<%= noticia.foto.toString('base64') %>" alt="<%= noticia.titulo %>">
                        <% } else { %>
                            <img src="/images/fotonot1.png" alt="<%= noticia.titulo %>">
                        <% } %>
                        <p class="textonoticias">
                            <strong><%= noticia.titulo %></strong><br>
                            <%= noticia.descricao || '' %>
                        </p>
                    </a>
                </div>
            <% }); %>
        <% } else { %>
            <p class="sem-noticias">Nenhuma notícia publicada ainda.</p>
        <% } %>

        </article>
    </main>
    <%- include('partials/modal-contato') %> 
    <%- include('partials/modal-feedback') %> 
    <%- include('partials/rodape') %> 
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="javascripts/menu.js"></script>
    <script src="javascripts/modal-contato.js"></script>
    <script src="javascripts/modal-feedback.js"></script>
</body>
</html>
