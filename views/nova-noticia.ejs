<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
    <link rel="stylesheet" href="/stylesheets/noticias.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"> 

</head>
<body>

    <div class="editor-noticia-wrapper">

        <div class="coluna-editor">
            <h1><%= noticia ? 'Editar Notícia' : 'Nova Notícia' %></h1>

            <% if (typeof erro !== 'undefined' && erro) { %>
                <div class="erro-noticia"><%= erro %></div>
            <% } %>

            <form id="form-noticia" method="POST"
                  action="<%= noticia ? '/noticias/' + noticia.id + '/editar' : '/noticias/nova/criar' %>"
                  enctype="multipart/form-data">

                <div class="campo-noticia">
                    <label for="titulo">Título</label>
                    <input type="text" id="titulo" name="titulo" required
                           value="<%= noticia ? noticia.titulo : '' %>">
                </div>

                <div class="campo-noticia">
                    <label for="descricao">Legenda / Resumo (aparece no card da home)</label>
                    <input type="text" id="descricao" name="descricao" maxlength="150"
                           value="<%= noticia ? (noticia.descricao || '') : '' %>">
                </div>

                <div class="campo-noticia">
                    <label for="imagem_capa">Imagem de capa (aparece no card da home)</label>
                    <% if (noticia && noticia.foto) { %>
                        <img class="preview-capa-atual" id="preview-capa-atual"
                             src="data:image/jpeg;base64,<%= noticia.foto.toString('base64') %>"
                             alt="Capa atual">
                        <p style="font-size:0.8rem;color:#666;margin-bottom:8px;">Envie uma nova imagem apenas se quiser substituir a atual.</p>
                    <% } %>
                    <input type="file" id="imagem_capa" name="imagem_capa" accept="image/*" <%= noticia ? '' : 'required' %>>
                </div>

                <hr style="margin: 24px 0; border-color: #e0e0e0;">

                <label style="font-weight:700;color:var(--cor02);display:block;margin-bottom:10px;">
                    Conteúdo do artigo (blocos)
                </label>

                <div class="lista-blocos-editor" id="lista-blocos-editor"></div>

                <button type="button" class="btn-add-bloco" id="btn-add-bloco">
                    <i class="fas fa-plus"></i> Adicionar bloco
                </button>

                <div class="botoes-container" style="margin-top:24px;">
                    <button type="submit" class="btn-publicar"><%= noticia ? 'SALVAR' : 'PUBLICAR' %></button>
                    <a href="/" class="btn-voltar">VOLTAR</a>
                </div>

            </form>
        </div>

        <div class="coluna-preview">
            <div class="preview-label">Pré-visualização</div>

            <img class="preview-capa" id="preview-capa-img" style="display:none;">

            <h2 class="preview-titulo" id="preview-titulo">Título da notícia</h2>
            <p class="preview-descricao" id="preview-descricao"></p>

            <div id="preview-blocos-container"></div>

            <p class="preview-vazio" id="preview-vazio">Adicione blocos para ver o artigo aqui.</p>
        </div>

    </div>

    <script>
        const BLOCOS_EXISTENTES = [
            <% if (blocos && blocos.length > 0) { %>
                <% blocos.forEach(function(bloco, i) { %>
                    {
                        texto: <%- JSON.stringify(bloco.texto || '') %>,
                        tipo: <%- JSON.stringify(bloco.tipo_texto || 'normal') %>,
                        citacaoAutor: <%- JSON.stringify(bloco.citacao_autor || '') %>,
                        imagemBase64: <%- bloco.imagem ? JSON.stringify(bloco.imagem.toString('base64')) : 'null' %>,
                        imagemAlt: <%- JSON.stringify(bloco.imagem_alt || '') %>,
                        imagemFonte: <%- JSON.stringify(bloco.imagem_fonte || '') %>,
                        imagemTamanho: <%- JSON.stringify(bloco.imagem_tamanho || 'grande') %>,
                        imagemOrientacao: <%- JSON.stringify(bloco.imagem_orientacao || 'horizontal') %>,
                        galeriaImagens: <%- JSON.stringify((bloco.galeriaImagens || []).map(function(img){ return { src: 'data:image/jpeg;base64,' + img.imagem.toString('base64'), alt: '' }; })) %>
                    }<%= i < blocos.length - 1 ? ',' : '' %>
                <% }); %>
            <% } %>
        ];

        const TIPOS_BLOCO = [
            { valor: 'normal', rotulo: 'Texto' },
            { valor: 'subtitulo', rotulo: 'Subtítulo' },
            { valor: 'citacao', rotulo: 'Citação' },
            { valor: 'separador', rotulo: 'Separador' },
            { valor: 'galeria', rotulo: 'Galeria de Imagens' }
        ];

        const CORES_TEXTO = [
            { classe: 'cor-preto', cor: '#111111' },
            { classe: 'cor-vermelho', cor: '#c0392b' },
            { classe: 'cor-azul', cor: '#2980b9' },
            { classe: 'cor-verde', cor: '#27ae60' },
            { classe: 'cor-laranja', cor: '#e67e22' },
            { classe: 'cor-roxo', cor: '#8e44ad' },
            { classe: 'cor-cinza', cor: '#7f8c8d' }
        ];
        const CORES_MARCA_TEXTO = [
            { classe: 'marca-amarelo', cor: '#fff3a0' },
            { classe: 'marca-verde', cor: '#c8f7c5' },
            { classe: 'marca-azul', cor: '#bee3f8' },
            { classe: 'marca-rosa', cor: '#fbd1e3' }
        ];
        const FONTES = [
            { valor: '', rotulo: 'Fonte padrão' },
            { valor: 'fonte-destaque', rotulo: 'Destaque' },
            { valor: 'fonte-serifada', rotulo: 'Serifada' },
            { valor: 'fonte-monoespacada', rotulo: 'Monoespaçada' }
        ];
        const TAMANHOS_FONTE = [
            { valor: '', rotulo: 'Tamanho' },
            { valor: 'texto-pequeno', rotulo: 'Pequeno' },
            { valor: 'texto-medio', rotulo: 'Médio' },
            { valor: 'texto-grande', rotulo: 'Grande' },
            { valor: 'texto-extra-grande', rotulo: 'Extra grande' }
        ];

        let contadorBlocos = 0;

        const listaBlocosEditor = document.getElementById('lista-blocos-editor');
        const previewBlocosContainer = document.getElementById('preview-blocos-container');
        const previewVazio = document.getElementById('preview-vazio');

        function criarBlocoEditor(dadosIniciais) {
            const index = contadorBlocos++;
            dadosIniciais = dadosIniciais || { texto: '', tipo: 'normal', citacaoAutor: '', imagemBase64: null };

            const wrapper = document.createElement('div');
            wrapper.className = 'bloco-editor';
            wrapper.dataset.index = index;
            wrapper.dataset.tipo = dadosIniciais.tipo;

            wrapper.innerHTML = montarHtmlBlocoEditor(index, dadosIniciais);
            listaBlocosEditor.appendChild(wrapper);

            const previewBloco = document.createElement('div');
            previewBloco.className = 'preview-bloco tipo-' + dadosIniciais.tipo;
            previewBloco.dataset.previewFor = index;
            previewBlocosContainer.appendChild(previewBloco);
            atualizarPreviewBloco(wrapper, previewBloco);

            ligarEventosBloco(wrapper, previewBloco);
            atualizarVisibilidadeVazio();
            renumerarBlocos();
        }

        function montarHtmlBlocoEditor(index, dados) {
            const optionsTipo = TIPOS_BLOCO.map(function(t) {
                return '<option value="' + t.valor + '"' + (dados.tipo === t.valor ? ' selected' : '') + '>' + t.rotulo + '</option>';
            }).join('');

            const imagemPreviewHtml = dados.imagemBase64
                ? '<img class="bloco-editor-imagem-preview" src="data:image/jpeg;base64,' + dados.imagemBase64 + '">'
                : '';

            if (dados.tipo === 'separador') {
                return cabecalhoBloco(index, optionsTipo) +
                    '<hr class="bloco-separador-preview-editor">' +
                    camposOcultosComuns() +
                    camposOcultosSeparador();
            }

            if (dados.tipo === 'galeria') {
                return cabecalhoBloco(index, optionsTipo) +
                    montarEditorGaleria(index, dados) +
                    camposOcultosComuns() +
                    camposOcultosSeparador();
            }

            const classeModo = dados.tipo === 'subtitulo' ? ' modo-subtitulo' : (dados.tipo === 'citacao' ? ' modo-citacao' : '');

            const campoAutorCitacao = dados.tipo === 'citacao'
                ? '<input type="text" class="campo-citacao-autor" name="blocos_citacao_autor[]" placeholder="Autor da citação (opcional)" value="' + escapeAtributo(dados.citacaoAutor || '') + '">'
                : '<input type="hidden" name="blocos_citacao_autor[]" value="">';

            // Input hidden com base64 da imagem já salva (usada se não vier novo upload)
            const imagemExistenteHtml = dados.imagemBase64
                ? '<input type="hidden" class="bloco-imagem-existente" name="bloco_imagem_existente_' + index + '" value="' + dados.imagemBase64 + '">'
                : '<input type="hidden" class="bloco-imagem-existente" name="bloco_imagem_existente_' + index + '" value="">';

            return cabecalhoBloco(index, optionsTipo) +
                imagemPreviewHtml +
                imagemExistenteHtml +
                '<input type="file" name="bloco_imagem_' + index + '" accept="image/*" class="bloco-input-imagem">' +
                montarControlesImagem(index, dados) +
                montarToolbar() +
                '<div class="bloco-texto-editavel' + classeModo + '" contenteditable="true" data-placeholder="Texto deste bloco">' + (dados.texto || '') + '</div>' +
                campoAutorCitacao +
                camposOcultosComuns();
        }

        function cabecalhoBloco(index, optionsTipoHtml) {
            return '<div class="bloco-editor-topo">' +
                '<div class="bloco-editor-topo-esquerda">' +
                    '<span class="rotulo-bloco">Bloco ' + (index + 1) + '</span>' +
                    '<select class="bloco-tipo-select">' + optionsTipoHtml + '</select>' +
                '</div>' +
                '<div class="bloco-editor-acoes">' +
                    '<button type="button" class="btn-icone-bloco subir" title="Mover para cima"><i class="fas fa-arrow-up"></i></button>' +
                    '<button type="button" class="btn-icone-bloco descer" title="Mover para baixo"><i class="fas fa-arrow-down"></i></button>' +
                    '<button type="button" class="btn-icone-bloco remover" title="Remover bloco"><i class="fas fa-trash"></i></button>' +
                '</div>' +
            '</div>';
        }

        function camposOcultosComuns() {
            return '<textarea name="blocos_texto[]" style="display:none;"></textarea>' +
                   '<input type="hidden" name="blocos_tipo[]" class="bloco-tipo-hidden" value="">';
        }

        function camposOcultosSeparador() {
            // Separador nao tem controles de imagem no HTML, entao precisa de campos hidden
            return '<input type="hidden" name="blocos_imagem_tamanho[]" value="grande">' +
                   '<input type="hidden" name="blocos_imagem_orientacao[]" value="horizontal">' +
                   '<input type="hidden" name="blocos_imagem_alt[]" value="">' +
                   '<input type="hidden" name="blocos_imagem_fonte[]" value="">';
        }

        function montarEditorGaleria(index, dados) {
            // Ao editar, imagens vêm de dados.galeriaImagens (banco); ao criar, de galData
            let galData = { cols: '3', altura: 'media', imagens: [] };
            try { if (dados.texto) galData = JSON.parse(dados.texto); } catch(e) {}
            const cols = galData.cols || '3';
            const altura = galData.altura || 'media';
            // Preferência: imagens carregadas do banco (edição); fallback: JSON salvo
            const imagens = (dados.galeriaImagens && dados.galeriaImagens.length > 0)
                ? dados.galeriaImagens
                : (galData.imagens || []);

            const thumbsHtml = imagens.map(function(img, i) {
                return '<div class="galeria-editor-item" data-idx="' + i + '">' +
                    '<img src="' + img.src + '" alt="' + escapeAtributo(img.alt || '') + '">' +
                    '<button type="button" class="btn-remover-img" data-idx="' + i + '" title="Remover">✕</button>' +
                '</div>';
            }).join('');

            return '<div class="galeria-controles">' +
                    '<label>Colunas:</label>' +
                    '<select class="select-galeria-cols">' +
                        '<option value="1"' + (cols==='1'?' selected':'') + '>1</option>' +
                        '<option value="2"' + (cols==='2'?' selected':'') + '>2</option>' +
                        '<option value="3"' + (cols==='3'?' selected':'') + '>3</option>' +
                        '<option value="4"' + (cols==='4'?' selected':'') + '>4</option>' +
                    '</select>' +
                    '<label>Altura:</label>' +
                    '<select class="select-galeria-altura">' +
                        '<option value="pequena"' + (altura==='pequena'?' selected':'') + '>Pequena</option>' +
                        '<option value="media"'   + (altura==='media'  ?' selected':'') + '>Média</option>' +
                        '<option value="grande"'  + (altura==='grande' ?' selected':'') + '>Grande</option>' +
                    '</select>' +
                '</div>' +
                '<div class="galeria-editor" id="galeria-editor-' + index + '">' +
                    thumbsHtml +
                    '<button type="button" class="btn-add-img-galeria" title="Adicionar imagem"><i class="fas fa-plus"></i></button>' +
                '</div>' +
                '<input type="file" accept="image/*" multiple class="bloco-input-galeria-file" style="display:none">';
        }

        function montarControlesImagem(index, dados) {
            const tam = dados.imagemTamanho || 'grande';
            const ori = dados.imagemOrientacao || 'horizontal';
            const alt = escapeAtributo(dados.imagemAlt || '');
            const fonte = escapeAtributo(dados.imagemFonte || '');
            return '<div class="bloco-imagem-controles">' +
                '<label>Tamanho:</label>' +
                '<select name="blocos_imagem_tamanho[]" class="select-img-tamanho">' +
                    '<option value="pequena"' + (tam === 'pequena' ? ' selected' : '') + '>Pequena</option>' +
                    '<option value="media"'   + (tam === 'media'   ? ' selected' : '') + '>Média</option>' +
                    '<option value="grande"'  + (tam === 'grande'  ? ' selected' : '') + '>Grande</option>' +
                    '<option value="gigante"' + (tam === 'gigante' ? ' selected' : '') + '>Gigante</option>' +
                '</select>' +
                '<label>Orientação:</label>' +
                '<select name="blocos_imagem_orientacao[]" class="select-img-orientacao">' +
                    '<option value="horizontal"' + (ori === 'horizontal' ? ' selected' : '') + '>Horizontal</option>' +
                    '<option value="vertical"'   + (ori === 'vertical'   ? ' selected' : '') + '>Vertical</option>' +
                '</select>' +
                '<label>Alt:</label>' +
                '<input type="text" name="blocos_imagem_alt[]" class="campo-img-alt" placeholder="Texto alternativo (acessibilidade)" value="' + alt + '">' +
                '<label>Fonte:</label>' +
                '<input type="text" name="blocos_imagem_fonte[]" class="campo-img-fonte" placeholder="Fonte / crédito da imagem" value="' + fonte + '">' +
            '</div>';
        }

        function montarToolbar() {
            const swatchesCor = CORES_TEXTO.map(function(c) {
                return '<span class="swatch-cor" data-classe="' + c.classe + '" style="background:' + c.cor + '"></span>';
            }).join('');
            const swatchesMarca = CORES_MARCA_TEXTO.map(function(c) {
                return '<span class="swatch-cor" data-classe="' + c.classe + '" style="background:' + c.cor + '"></span>';
            }).join('');
            const optionsFonte = FONTES.map(function(f) {
                return '<option value="' + f.valor + '">' + f.rotulo + '</option>';
            }).join('');
            const optionsTamanho = TAMANHOS_FONTE.map(function(t) {
                return '<option value="' + t.valor + '">' + t.rotulo + '</option>';
            }).join('');

            return '<div class="bloco-toolbar">' +
                '<div class="grupo-toolbar">' +
                    '<button type="button" data-acao="bold" title="Negrito"><i class="fas fa-bold"></i></button>' +
                    '<button type="button" data-acao="italic" title="Itálico"><i class="fas fa-italic"></i></button>' +
                    '<button type="button" data-acao="underline" title="Sublinhado"><i class="fas fa-underline"></i></button>' +
                    '<button type="button" data-acao="strikeThrough" title="Tachado"><i class="fas fa-strikethrough"></i></button>' +
                '</div>' +
                '<div class="grupo-toolbar">' +
                    '<div class="dropdown-cor">' +
                        '<button type="button" class="btn-abrir-cor" title="Cor do texto"><i class="fas fa-font"></i></button>' +
                        '<div class="painel-cores cores-texto">' + swatchesCor + '</div>' +
                    '</div>' +
                    '<div class="dropdown-cor">' +
                        '<button type="button" class="btn-abrir-marca" title="Marca-texto"><i class="fas fa-highlighter"></i></button>' +
                        '<div class="painel-cores cores-marca">' + swatchesMarca + '<span class="swatch-cor swatch-limpar-marca" title="Remover marca-texto" style="background:#fff;font-size:13px;display:flex;align-items:center;justify-content:center;">✕</span></div>' +
                    '</div>' +
                '</div>' +
                '<div class="grupo-toolbar">' +
                    '<select class="select-fonte" title="Família da fonte">' + optionsFonte + '</select>' +
                    '<select class="select-tamanho" title="Tamanho da fonte">' + optionsTamanho + '</select>' +
                '</div>' +
                '<div class="grupo-toolbar">' +
                    '<button type="button" data-acao="alinhar-esquerda" title="Alinhar à esquerda"><i class="fas fa-align-left"></i></button>' +
                    '<button type="button" data-acao="alinhar-centro" title="Centralizar"><i class="fas fa-align-center"></i></button>' +
                    '<button type="button" data-acao="alinhar-direita" title="Alinhar à direita"><i class="fas fa-align-right"></i></button>' +
                    '<button type="button" data-acao="alinhar-justificado" title="Justificar"><i class="fas fa-align-justify"></i></button>' +
                '</div>' +
                '<div class="grupo-toolbar">' +
                    '<button type="button" data-acao="lista-marcadores" title="Lista com marcadores"><i class="fas fa-list-ul"></i></button>' +
                    '<button type="button" data-acao="lista-numerada" title="Lista numerada"><i class="fas fa-list-ol"></i></button>' +
                    '<button type="button" data-acao="lista-tarefa" title="Lista de tarefas"><i class="fas fa-tasks"></i></button>' +
                '</div>' +
                '<div class="grupo-toolbar">' +
                    '<button type="button" data-acao="link" title="Inserir link"><i class="fas fa-link"></i></button>' +
                '</div>' +
            '</div>';
        }

        function ligarEventosBloco(wrapper, previewBloco) {
            const tipoSelect = wrapper.querySelector('.bloco-tipo-select');
            const tipoHidden = wrapper.querySelector('.bloco-tipo-hidden');
            tipoHidden.value = wrapper.dataset.tipo;

            if (tipoSelect) {
                tipoSelect.addEventListener('change', function() {
                    const novoTipo = tipoSelect.value;
                    const index = parseInt(wrapper.dataset.index, 10);
                    const textoAtual = (wrapper.querySelector('.bloco-texto-editavel') || {}).innerHTML || '';
                    const imgEditorAtual = wrapper.querySelector('.bloco-editor-imagem-preview');
                    const imagemBase64Atual = imgEditorAtual ? imgEditorAtual.src.split(',')[1] : null;

                    wrapper.dataset.tipo = novoTipo;
                    wrapper.innerHTML = montarHtmlBlocoEditor(index, {
                        texto: textoAtual,
                        tipo: novoTipo,
                        citacaoAutor: '',
                        imagemBase64: imagemBase64Atual
                    });

                    previewBloco.className = 'preview-bloco tipo-' + novoTipo;
                    ligarEventosBloco(wrapper, previewBloco);
                    atualizarPreviewBloco(wrapper, previewBloco);
                    renumerarBlocos();
                });
            }

            const inputImagem = wrapper.querySelector('.bloco-input-imagem');
            if (inputImagem) {
                inputImagem.addEventListener('change', function() {
                    if (!inputImagem.files || !inputImagem.files[0]) return;
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        let imgEditor = wrapper.querySelector('.bloco-editor-imagem-preview');
                        if (!imgEditor) {
                            imgEditor = document.createElement('img');
                            imgEditor.className = 'bloco-editor-imagem-preview';
                            wrapper.insertBefore(imgEditor, inputImagem);
                        }
                        imgEditor.src = e.target.result;
                        // Atualiza o hidden para o backend usar se o file input não chegar
                        const hiddenExistente = wrapper.querySelector('.bloco-imagem-existente');
                        if (hiddenExistente) hiddenExistente.value = e.target.result.split(',')[1];
                        atualizarPreviewBloco(wrapper, previewBloco);
                    };
                    reader.readAsDataURL(inputImagem.files[0]);
                });
            }

            // Controles de imagem: tamanho, orientação, alt, fonte
            ['select-img-tamanho', 'select-img-orientacao'].forEach(function(cls) {
                const el = wrapper.querySelector('.' + cls);
                if (el) el.addEventListener('change', function() { atualizarPreviewBloco(wrapper, previewBloco); });
            });
            ['campo-img-alt', 'campo-img-fonte'].forEach(function(cls) {
                const el = wrapper.querySelector('.' + cls);
                if (el) el.addEventListener('input', function() { atualizarPreviewBloco(wrapper, previewBloco); });
            });

            // ── Galeria ──────────────────────────────────────────────────────
            if (wrapper.dataset.tipo === 'galeria') {
                ligarEventosGaleria(wrapper, previewBloco);
            }

            const editavel = wrapper.querySelector('.bloco-texto-editavel');
            if (editavel) {
                editavel.addEventListener('input', function() {
                    limparSpansVazios(editavel);
                    atualizarPreviewBloco(wrapper, previewBloco);
                });
                // Salva seleção ao perder foco (blur) para que botões da toolbar possam usá-la
                editavel.addEventListener('blur', function() {
                    const sel = window.getSelection();
                    if (sel && sel.rangeCount && !sel.isCollapsed && editavel.contains(sel.getRangeAt(0).commonAncestorContainer)) {
                        selecaoSalva = { editavel: editavel, range: sel.getRangeAt(0).cloneRange() };
                    }
                });
            }

            const campoAutor = wrapper.querySelector('.campo-citacao-autor');
            if (campoAutor) {
                campoAutor.addEventListener('input', function() {
                    atualizarPreviewBloco(wrapper, previewBloco);
                });
            }

            wrapper.querySelectorAll('.bloco-toolbar button[data-acao]').forEach(function(botao) {
                botao.addEventListener('mousedown', function(e) { e.preventDefault(); });
                botao.addEventListener('click', function() {
                    if (!editavel) return;
                    editavel.focus();
                    executarAcaoToolbar(botao.dataset.acao, editavel);
                    atualizarPreviewBloco(wrapper, previewBloco);
                });
            });

                        const selectFonte = wrapper.querySelector('.select-fonte');
            if (selectFonte) {
                selectFonte.addEventListener('change', function() {
                    if (!editavel) return;
                    aplicarSpanNaSelecao(editavel, selectFonte.value);
                    atualizarPreviewBloco(wrapper, previewBloco);
                });
            }
                        const selectTamanho = wrapper.querySelector('.select-tamanho');
            if (selectTamanho) {
                selectTamanho.addEventListener('change', function() {
                    if (!editavel) return;
                    aplicarSpanNaSelecao(editavel, selectTamanho.value);
                    atualizarPreviewBloco(wrapper, previewBloco);
                });
            }

            const btnAbrirCor = wrapper.querySelector('.btn-abrir-cor');
            if (btnAbrirCor) {
                btnAbrirCor.addEventListener('mousedown', function(e) { e.preventDefault(); });
                btnAbrirCor.addEventListener('click', function(e) {
                    e.stopPropagation();
                    wrapper.querySelector('.cores-texto').classList.toggle('aberto');
                });
                wrapper.querySelector('.cores-texto').addEventListener('mousedown', function(e) {
                    e.preventDefault();
                });
                wrapper.querySelectorAll('.cores-texto .swatch-cor').forEach(function(swatch) {
                    swatch.addEventListener('click', function() {
                        if (!editavel) return;
                        aplicarSpanNaSelecao(editavel, swatch.dataset.classe);
                        wrapper.querySelector('.cores-texto').classList.remove('aberto');
                        atualizarPreviewBloco(wrapper, previewBloco);
                    });
                });
            }
            const btnAbrirMarca = wrapper.querySelector('.btn-abrir-marca');
            if (btnAbrirMarca) {
                btnAbrirMarca.addEventListener('mousedown', function(e) { e.preventDefault(); });
                btnAbrirMarca.addEventListener('click', function(e) {
                    e.stopPropagation();
                    wrapper.querySelector('.cores-marca').classList.toggle('aberto');
                });
                wrapper.querySelector('.cores-marca').addEventListener('mousedown', function(e) {
                    e.preventDefault();
                });
                wrapper.querySelectorAll('.cores-marca .swatch-cor').forEach(function(swatch) {
                    swatch.addEventListener('click', function() {
                        if (!editavel) return;
                        if (swatch.classList.contains('swatch-limpar-marca')) {
                            limparMarcaTexto(editavel);
                        } else {
                            aplicarSpanNaSelecao(editavel, swatch.dataset.classe);
                        }
                        wrapper.querySelector('.cores-marca').classList.remove('aberto');
                        atualizarPreviewBloco(wrapper, previewBloco);
                    });
                });
            }

            wrapper.querySelector('.remover').addEventListener('click', function() {
                wrapper.remove();
                previewBloco.remove();
                atualizarVisibilidadeVazio();
                renumerarBlocos();
            });

            wrapper.querySelector('.subir').addEventListener('click', function() {
                const anterior = wrapper.previousElementSibling;
                if (anterior) {
                    listaBlocosEditor.insertBefore(wrapper, anterior);
                    const previewAnterior = previewBloco.previousElementSibling;
                    if (previewAnterior) previewBlocosContainer.insertBefore(previewBloco, previewAnterior);
                    renumerarBlocos();
                }
            });

            wrapper.querySelector('.descer').addEventListener('click', function() {
                const proximo = wrapper.nextElementSibling;
                if (proximo) {
                    listaBlocosEditor.insertBefore(proximo, wrapper);
                    const previewProximo = previewBloco.nextElementSibling;
                    if (previewProximo) previewBlocosContainer.insertBefore(previewProximo, previewBloco);
                    renumerarBlocos();
                }
            });
        }

