        // Grupos mutuamente exclusivos: aplicar uma classe remove as outras do mesmo grupo
        const GRUPOS_EXCLUSIVOS = [
            ['cor-preto', 'cor-vermelho', 'cor-azul', 'cor-verde', 'cor-laranja', 'cor-roxo', 'cor-cinza'],
            ['marca-amarelo', 'marca-verde', 'marca-azul', 'marca-rosa'],
            ['texto-pequeno', 'texto-medio', 'texto-grande', 'texto-extra-grande'],
            ['fonte-padrao', 'fonte-destaque', 'fonte-serifada', 'fonte-monoespacada']
        ];

        // Seleção salva para uso após perda de foco (clique em swatch/select)
        let selecaoSalva = null;

        document.addEventListener('selectionchange', function() {
            const sel = window.getSelection();
            if (sel && sel.rangeCount && !sel.isCollapsed) {
                const range = sel.getRangeAt(0);
                const editores = document.querySelectorAll('.bloco-texto-editavel');
                for (let ed of editores) {
                    if (ed.contains(range.commonAncestorContainer)) {
                        selecaoSalva = { editavel: ed, range: range.cloneRange() };
                        break;
                    }
                }
            }
        });

        // Remove classes de um grupo de um elemento span e de todos os seus descendentes spans
        function limparGrupoNoFragmento(no, grupo) {
            if (no.nodeType === Node.ELEMENT_NODE && no.tagName === 'SPAN') {
                grupo.forEach(function(c) { no.classList.remove(c); });
            }
            no.childNodes.forEach(function(filho) { limparGrupoNoFragmento(filho, grupo); });
        }

        // Desfaz spans vazios (sem classe) após limpeza
        function achatarSpansVazios(fragmento) {
            fragmento.querySelectorAll('span').forEach(function(s) {
                if (!s.className || s.className.trim() === '') {
                    const pai = s.parentNode;
                    while (s.firstChild) pai.insertBefore(s.firstChild, s);
                    pai.removeChild(s);
                }
            });
        }

        // Remove spans de formatação (marca-texto, cor, etc.) que ficaram
        // sem nenhum texto dentro, para não deixar "casca" vazia nem herdar
        // a formatação ao digitar de novo naquele ponto.
                function limparSpansVazios(editavel) {
            // Se o campo ficou totalmente vazio mas ainda sobrou algum
            // <span> de formatação, zera tudo e força o navegador a
            // esquecer o "typing style" (bug conhecido do Chromium que
            // não é resolvido só mexendo no DOM via JS).
            const textoTotal = editavel.textContent.replace(/\u200B/g, '').trim();
            if (textoTotal.length === 0 && editavel.querySelector('span')) {
                editavel.innerHTML = '';
                editavel.blur();
                setTimeout(function() {
                    editavel.focus();
                    const selVazio = window.getSelection();
                    const rangeVazio = document.createRange();
                    rangeVazio.selectNodeContents(editavel);
                    rangeVazio.collapse(true);
                    selVazio.removeAllRanges();
                    selVazio.addRange(rangeVazio);
                }, 0);
                return;
            }

            const sel = window.getSelection();
            let cursorNode = null;
            if (sel && sel.rangeCount) {
                cursorNode = sel.getRangeAt(0).startContainer;
            }

            const spans = Array.from(editavel.querySelectorAll('span'));
            spans.forEach(function(span) {
                const conteudo = span.textContent.replace(/\u200B/g, '').trim();
                if (conteudo.length === 0) {
                    const cursorEstavaDentro = cursorNode && span.contains(cursorNode);
                    const pai = span.parentNode;
                    const proximoIrmao = span.nextSibling;
                    span.remove();

                    if (cursorEstavaDentro) {
                        // Coloca o cursor num nó de texto neutro, fora de
                        // qualquer span, para o navegador esquecer a cor/estilo
                        // que estava "grudado" no cursor.
                        const textoNeutro = document.createTextNode('');
                        if (proximoIrmao) {
                            pai.insertBefore(textoNeutro, proximoIrmao);
                        } else {
                            pai.appendChild(textoNeutro);
                        }
                        const novoRange = document.createRange();
                        novoRange.setStart(textoNeutro, 0);
                        novoRange.collapse(true);
                        sel.removeAllRanges();
                        sel.addRange(novoRange);
                    }
                }
            });
            editavel.normalize();
        }

        // Corta (divide) qualquer elemento ancestral do marcador, até chegar
        // em `root`, movendo tudo que vem depois do marcador para um clone
        // irmão. Isso garante que nenhum span fique "atravessado" pela
        // fronteira exata da seleção — essencial para marcar/desmarcar
        // apenas parte de um trecho já formatado.
        function dividirAncestraisNoMarcador(marcador, root) {
            let node = marcador;
            let parent = node.parentNode;
            while (parent && parent !== root) {
                const proximosIrmaos = [];
                let irmao = node.nextSibling;
                while (irmao) {
                    proximosIrmaos.push(irmao);
                    irmao = irmao.nextSibling;
                }
                if (proximosIrmaos.length > 0) {
                    const clone = parent.cloneNode(false);
                    proximosIrmaos.forEach(function(ir) { clone.appendChild(ir); });
                    parent.parentNode.insertBefore(clone, parent.nextSibling);
                }
                node = parent;
                parent = node.parentNode;
            }
        }

        // Percorre, em ordem do documento, todo elemento <span> que esteja
        // inteiramente entre os dois marcadores (agora sempre inteiro, nunca
        // parcial, graças à divisão feita acima).
        function percorrerEntreMarcadores(root, marcadorInicio, marcadorFim, callback) {
            const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT, null);
            let dentro = false;
            let node = walker.nextNode();
            while (node) {
                if (node === marcadorInicio) { dentro = true; node = walker.nextNode(); continue; }
                if (node === marcadorFim) { break; }
                if (dentro && node.tagName === 'SPAN') callback(node);
                node = walker.nextNode();
            }
        }

        function aplicarSpanNaSelecao(editavel, classe) {
            if (!classe) return;

            let range = null;
            const sel = window.getSelection();
            if (sel && sel.rangeCount && !sel.isCollapsed && editavel.contains(sel.getRangeAt(0).commonAncestorContainer)) {
                range = sel.getRangeAt(0);
            } else if (selecaoSalva && selecaoSalva.editavel === editavel) {
                sel.removeAllRanges();
                sel.addRange(selecaoSalva.range);
                range = selecaoSalva.range;
            }

            if (!range) {
                alert('Selecione um trecho de texto antes de aplicar esta formatação.');
                return;
            }

            const grupoAtual = GRUPOS_EXCLUSIVOS.find(g => g.includes(classe)) || null;
            const classesMarca = ['marca-amarelo', 'marca-verde', 'marca-azul', 'marca-rosa'];

            const marcadorFim = document.createElement('span');
            marcadorFim.setAttribute('data-marcador', '1');
            const rangeFim = range.cloneRange();
            rangeFim.collapse(false);
            rangeFim.insertNode(marcadorFim);

            const marcadorInicio = document.createElement('span');
            marcadorInicio.setAttribute('data-marcador', '1');
            const rangeInicio = range.cloneRange();
            rangeInicio.collapse(true);
            rangeInicio.insertNode(marcadorInicio);

            dividirAncestraisNoMarcador(marcadorInicio, editavel);
            dividirAncestraisNoMarcador(marcadorFim, editavel);

            if (classesMarca.includes(classe)) {
                percorrerEntreMarcadores(editavel, marcadorInicio, marcadorFim, function(span) {
                    classesMarca.forEach(function(c) { span.classList.remove(c); });
                });
            }

            const novoRangeSelecao = document.createRange();
            novoRangeSelecao.setStartAfter(marcadorInicio);
            novoRangeSelecao.setEndBefore(marcadorFim);
            const fragmento = novoRangeSelecao.extractContents();

            if (grupoAtual) {
                limparGrupoNoFragmento(fragmento, grupoAtual);
            }
            achatarSpansVazios(fragmento);

            const span = document.createElement('span');
            span.className = classe;
            span.appendChild(fragmento);
            novoRangeSelecao.insertNode(span);

            marcadorInicio.remove();
            marcadorFim.remove();
            editavel.normalize();
            limparSpansVazios(editavel);

            const novoRange = document.createRange();
            novoRange.setStartAfter(span);
            novoRange.collapse(true);
            sel.removeAllRanges();
            sel.addRange(novoRange);
        }

        function aplicarAlinhamento(editavel, classe) {
    const classesAlinhamento = ['alinhar-esquerda', 'alinhar-centro', 'alinhar-direita', 'alinhar-justificado'];

    // Garante uma única "casca" envolvendo todo o conteúdo do bloco.
    // Se já existe, só troca a classe dela — nunca cria uma nova por
    // cima, o que evita o aninhamento que travava ao alternar.
    let wrapper = editavel.querySelector(':scope > span[data-alinhamento]');
    if (!wrapper) {
        wrapper = document.createElement('span');
        wrapper.setAttribute('data-alinhamento', '1');
        while (editavel.firstChild) {
            wrapper.appendChild(editavel.firstChild);
        }
        editavel.appendChild(wrapper);
    }

    classesAlinhamento.forEach(function(c) { wrapper.classList.remove(c); });
    wrapper.classList.add(classe);
}

        function limparMarcaTexto(editavel) {
            const classesMarca = ['marca-amarelo', 'marca-verde', 'marca-azul', 'marca-rosa'];

            let range = null;
            const sel = window.getSelection();
            if (sel && sel.rangeCount && !sel.isCollapsed && editavel.contains(sel.getRangeAt(0).commonAncestorContainer)) {
                range = sel.getRangeAt(0);
            } else if (selecaoSalva && selecaoSalva.editavel === editavel) {
                range = selecaoSalva.range;
            }
            if (!range) { alert('Selecione o texto marcado para remover o destaque.'); return; }

            const marcadorFim = document.createElement('span');
            marcadorFim.setAttribute('data-marcador', '1');
            const rangeFim = range.cloneRange();
            rangeFim.collapse(false);
            rangeFim.insertNode(marcadorFim);

            const marcadorInicio = document.createElement('span');
            marcadorInicio.setAttribute('data-marcador', '1');
            const rangeInicio = range.cloneRange();
            rangeInicio.collapse(true);
            rangeInicio.insertNode(marcadorInicio);

            dividirAncestraisNoMarcador(marcadorInicio, editavel);
            dividirAncestraisNoMarcador(marcadorFim, editavel);

            percorrerEntreMarcadores(editavel, marcadorInicio, marcadorFim, function(span) {
                classesMarca.forEach(function(c) { span.classList.remove(c); });
            });

            marcadorInicio.remove();
            marcadorFim.remove();
            editavel.normalize();
            limparSpansVazios(editavel);
        }

        function inserirListaTarefa(editavel) {
            document.execCommand('insertUnorderedList');
            const listas = editavel.querySelectorAll('ul');
            if (listas.length > 0) {
                const ultimaLista = listas[listas.length - 1];
                const ultimoItem = ultimaLista.querySelector('li:last-child');
                if (ultimoItem && !ultimoItem.classList.contains('tarefa')) {
                    ultimoItem.classList.add('tarefa');
                    ultimoItem.innerHTML = '<input type="checkbox"> ' + (ultimoItem.innerHTML || 'Nova tarefa');
                }
            }
        }

        function inserirLink(editavel) {
            const selecao = window.getSelection();
            const textoSelecionado = selecao.toString();

            const url = prompt('URL do link:', 'https://');
            if (!url) return;

            const textoLink = prompt('Texto do link:', textoSelecionado || url);
            if (!textoLink) return;

            const novaAba = confirm('Abrir em uma nova aba?');

            const a = document.createElement('a');
            a.href = url;
            a.textContent = textoLink;
            if (novaAba) {
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
            }

            if (selecao.rangeCount > 0 && !selecao.isCollapsed) {
                const range = selecao.getRangeAt(0);
                range.deleteContents();
                range.insertNode(a);
            } else {
                editavel.appendChild(a);
            }
        }

        function atualizarPreviewBloco(wrapper, previewBloco) {
            const tipo = wrapper.dataset.tipo;
            const editavel = wrapper.querySelector('.bloco-texto-editavel');
            const textareaOculta = wrapper.querySelector('textarea');
            const imgEditor = wrapper.querySelector('.bloco-editor-imagem-preview');
            const campoAutor = wrapper.querySelector('.campo-citacao-autor');

            if (textareaOculta) {
                textareaOculta.value = editavel ? editavel.innerHTML : '';
            }

            const selectTam = wrapper.querySelector('.select-img-tamanho');
            const selectOri = wrapper.querySelector('.select-img-orientacao');
            const campoAlt = wrapper.querySelector('.campo-img-alt');
            const campoFonte = wrapper.querySelector('.campo-img-fonte');

            let html = '';
            if (imgEditor) {
                const tam = selectTam ? selectTam.value : 'grande';
                const ori = selectOri ? selectOri.value : 'horizontal';
                const alt = campoAlt ? escapeHtml(campoAlt.value) : '';
                const fonte = campoFonte ? escapeHtml(campoFonte.value) : '';
                html += '<figure style="margin:0">' +
                    '<img src="' + imgEditor.src + '" alt="' + alt + '" ' +
                    'class="img-tamanho-' + tam + ' img-orientacao-' + ori + '" ' +
                    'style="object-fit:cover;border-radius:6px;display:block;">' +
                    (fonte ? '<figcaption class="legenda-imagem">Fonte: ' + fonte + '</figcaption>' : '') +
                    '</figure>';
            }

            if (tipo === 'separador') {
                html += '<hr>';
            } else if (tipo === 'galeria') {
                // Lê direto do DOM (mais confiável que a textarea que pode estar desatualizada)
                const selCols   = wrapper.querySelector('.select-galeria-cols');
                const selAltura = wrapper.querySelector('.select-galeria-altura');
                const cols   = selCols   ? selCols.value   : '3';
                const altura = selAltura ? selAltura.value : 'media';
                const thumbImgs = Array.from(wrapper.querySelectorAll('.galeria-editor-item img'));
                if (thumbImgs.length === 0) {
                    html += '<p style="color:#aaa;font-size:0.85rem;">Nenhuma imagem adicionada ainda.</p>';
                } else {
                    html += '<div class="preview-galeria cols-' + cols + ' altura-' + altura + '">' +
                        thumbImgs.map(function(img) {
                            return '<img src="' + img.src + '" alt="' + escapeHtml(img.alt || '') + '">';
                        }).join('') +
                    '</div>';
                }
            } else {
                html += '<div class="conteudo-texto">' + (editavel ? editavel.innerHTML : '') + '</div>';
                if (tipo === 'citacao' && campoAutor && campoAutor.value.trim()) {
                    html += '<span class="autor-citacao">' + escapeHtml(campoAutor.value.trim()) + '</span>';
                }
            }

            previewBloco.innerHTML = html;
        }

        function renumerarBlocos() {
            const blocosWrapper = Array.from(listaBlocosEditor.querySelectorAll('.bloco-editor'));
            blocosWrapper.forEach(function(wrapper, novoIndex) {
                const rotulo = wrapper.querySelector('.rotulo-bloco');
                if (rotulo) rotulo.textContent = 'Bloco ' + (novoIndex + 1);

                const inputImagem = wrapper.querySelector('.bloco-input-imagem');
                if (inputImagem) inputImagem.name = 'bloco_imagem_' + novoIndex;

                wrapper.dataset.index = novoIndex;
            });
        }

        function atualizarVisibilidadeVazio() {
            previewVazio.style.display = listaBlocosEditor.children.length === 0 ? 'block' : 'none';
        }

        function escapeHtml(texto) {
            const div = document.createElement('div');
            div.textContent = texto;
            return div.innerHTML;
        }

        function escapeAtributo(texto) {
            return String(texto).replace(/"/g, '&quot;');
        }

        document.addEventListener('click', function() {
            document.querySelectorAll('.painel-cores.aberto').forEach(function(p) {
                p.classList.remove('aberto');
            });
        });

        document.getElementById('btn-add-bloco').addEventListener('click', function() {
            criarBlocoEditor();
        });

        const inputTitulo = document.getElementById('titulo');
        const inputDescricao = document.getElementById('descricao');
        const inputCapa = document.getElementById('imagem_capa');
        const previewTitulo = document.getElementById('preview-titulo');
        const previewDescricao = document.getElementById('preview-descricao');
        const previewCapaImg = document.getElementById('preview-capa-img');

        inputTitulo.addEventListener('input', function() {
            previewTitulo.textContent = inputTitulo.value || 'Título da notícia';
        });
        inputDescricao.addEventListener('input', function() {
            previewDescricao.textContent = inputDescricao.value;
        });
        inputCapa.addEventListener('change', function() {
            if (!inputCapa.files || !inputCapa.files[0]) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                previewCapaImg.src = e.target.result;
                previewCapaImg.style.display = 'block';
            };
            reader.readAsDataURL(inputCapa.files[0]);
        });

        previewTitulo.textContent = inputTitulo.value || 'Título da notícia';
        previewDescricao.textContent = inputDescricao.value;
        <% if (noticia && noticia.foto) { %>
            previewCapaImg.src = document.getElementById('preview-capa-atual').src;
            previewCapaImg.style.display = 'block';
        <% } %>

        if (BLOCOS_EXISTENTES.length > 0) {
            BLOCOS_EXISTENTES.forEach(function(bloco) {
                criarBlocoEditor(bloco);
            });
        } else {
            atualizarVisibilidadeVazio();
        }

        document.getElementById('form-noticia').addEventListener('submit', function() {
            document.querySelectorAll('.bloco-editor').forEach(function(wrapper) {
                const editavel = wrapper.querySelector('.bloco-texto-editavel');
                const textareaOculta = wrapper.querySelector('textarea');
                if (editavel && textareaOculta) {
                    textareaOculta.value = editavel.innerHTML;
                }
            });
        });
    </script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
