        function adicionarInputsOcultosGaleria(wrapper, index) {
            // Remove inputs antigos
            wrapper.querySelectorAll('.galeria-hidden-input').forEach(function(el) { el.remove(); });
            // Cria um input hidden para cada imagem (src base64) para envio ao servidor
            const thumbs = Array.from(wrapper.querySelectorAll('.galeria-editor-item img'));
            thumbs.forEach(function(img, i) {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'galeria_img_' + index + '_' + i;
                inp.value = img.src; // base64
                inp.className = 'galeria-hidden-input';
                wrapper.appendChild(inp);
            });
        }

        function ligarEventosGaleria(wrapper, previewBloco) {
            const index = parseInt(wrapper.dataset.index, 10);

            function atualizar() {
                salvarGaleriaNoTextarea(wrapper);
                adicionarInputsOcultosGaleria(wrapper, index);
                atualizarPreviewBloco(wrapper, previewBloco);
                atualizarBtnAdd(wrapper);
            }

            const selCols = wrapper.querySelector('.select-galeria-cols');
            const selAltura = wrapper.querySelector('.select-galeria-altura');
            if (selCols) selCols.addEventListener('change', function() { atualizar(); atualizarBtnAdd(wrapper); });
            if (selAltura) selAltura.addEventListener('change', atualizar);

            const btnAdd = wrapper.querySelector('.btn-add-img-galeria');
            const fileInput = wrapper.querySelector('.bloco-input-galeria-file');
            if (btnAdd && fileInput) {
                btnAdd.addEventListener('click', function() { fileInput.click(); });
                fileInput.addEventListener('change', function() {
                    const files = Array.from(fileInput.files);
                    const galeriaDiv = wrapper.querySelector('.galeria-editor');
                    let pendentes = files.length;
                    if (pendentes === 0) return;
                    files.forEach(function(file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const item = document.createElement('div');
                            item.className = 'galeria-editor-item';
                            item.innerHTML =
                                '<img src="' + e.target.result + '" alt="">' +
                                '<button type="button" class="btn-remover-img" title="Remover">✕</button>';
                            item.querySelector('.btn-remover-img').addEventListener('click', function() {
                                item.remove();
                                atualizar();
                            });
                            galeriaDiv.insertBefore(item, btnAdd);
                            pendentes--;
                            if (pendentes === 0) atualizar();
                        };
                        reader.readAsDataURL(file);
                    });
                    fileInput.value = '';
                });
            }

            wrapper.querySelectorAll('.btn-remover-img').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    btn.closest('.galeria-editor-item').remove();
                    atualizar();
                });
            });

            // Estado inicial
            atualizar();
        }

