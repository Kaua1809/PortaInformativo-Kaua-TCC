        function salvarGaleriaNoTextarea(wrapper) {
            const ta = wrapper.querySelector('textarea');
            if (ta) ta.value = JSON.stringify(lerGaleriaJson(wrapper));
        }

        function atualizarBtnAdd(wrapper) {
            const selCols = wrapper.querySelector('.select-galeria-cols');
            const maxImgs = selCols ? parseInt(selCols.value) * 4 : 12; // máx: 4 linhas de imgs
            const total   = wrapper.querySelectorAll('.galeria-editor-item').length;
            const btnAdd  = wrapper.querySelector('.btn-add-img-galeria');
            if (!btnAdd) return;
            // Limite: número de colunas × 4 linhas (ex: 3 colunas = máx 12 imagens)
