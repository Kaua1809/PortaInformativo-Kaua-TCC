<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<div id="modal-contato" class="modal-container">
    <div class="modal-box">

        <h1><i class="bi bi-telephone-fill"></i> Contato</h1>

        <p>Email: PortalInformativo@gmail.com
            Whatsapp: (numero)
            Ou preencha o formulário:
        </p>

        <form class="form-contato" id="form-contato">

            <div class="campo-contato">
                <label class="label-contato" for="contato-nome">Nome:</label>
                <input class="input-contato" type="text" id="contato-nome" name="nome" required>
            </div>

            <div class="campo-contato">
                <label class="label-contato" for="contato-sobrenome">Sobrenome:</label>
                <input class="input-contato" type="text" id="contato-sobrenome" name="sobrenome">
            </div>

            <div class="campo-contato">
                <label class="label-contato" for="contato-email">E-mail:</label>
                <input class="input-contato" type="email" id="contato-email" name="email" required>
            </div>

            <div class="campo-contato">
                <label class="label-contato" for="contato-telefone">Telefone:</label>
                <input class="input-contato" type="tel" id="contato-telefone" name="telefone">
            </div>

            <div class="campo-mensagem">
                <label class="label-contato" for="contato-relato">Relatar:</label>
                <textarea class="input-mensagem" id="contato-relato" name="relato" required></textarea>
            </div>

            <div class="modal-footer">
                <button class="enviar" id="enviar-contato" type="button">Enviar</button>
                <button class="fechar" id="fechar" type="button">Fechar</button>
            </div>

        </form>

    </div>
</div>
