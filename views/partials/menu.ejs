    <% if (usuarioLogado && usuarioLogado.is_admin) { %>
        <a href="/admin/denuncias"><i class="bi bi-shield-exclamation"></i> Painel de Moderação</a>
    <% } %>

    <!-- SEÇÃO DE CONTA DINÂMICA -->
    <div class="secao-conta">
        <% if (usuarioLogado) { %>
            <!-- APARECE APENAS SE ESTIVER LOGADO -->
            <a href="/conta" class="perfil-usuario">
                <div class="avatar-container">
<img src="<%= usuarioLogado.foto_perfil || (locals.FOTO_PADRAO || '/images/default-avatar.png') %>" alt="Foto de Perfil" class="foto-perfil">

                </div>
                <span class="nome-usuario2"><%= usuarioLogado.nome_exibicao %></span>
            </a>
        <% } else { %>
            <!-- APARECE APENAS SE NÃO ESTIVER LOGADO -->
            <div class="links-autenticacao">
                <a href="/login" class="btn-entrar">Entrar</a>
                <a href="/cadastro" class="btn-cadastrar">Cadastrar</a>
            </div>
        <% } %>
    </div>
