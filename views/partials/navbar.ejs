<!-- PESQUISA -->
<div class="search-bar">
    <button id="searchBtn"><i class="bi bi-search"></i></button>
    <input type="text" id="searchInput" placeholder="Pesquisar...">
</div>

<script>
document.getElementById("searchBtn").addEventListener("click", buscar);

document.getElementById("searchInput").addEventListener("keypress", function(e) {
    if (e.key === "Enter") {
        buscar();
    }
});

function buscar() {
    let valor = document.getElementById("searchInput").value.trim();

    if (valor !== "") {
        window.location.href = "/pesquisa/resultado?q=" + encodeURIComponent(valor);
    } else {
        alert("Digite algo para pesquisar");
    }
}
</script>