<%- include('filtros-logo') %>
<!--ICONES-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<!-- LOGO -->
    <img src="/images/logo.png" alt="Logo" class="logo">

    <!-- TÍTULO -->
    <h1><%= title %></h1> 
    <% if (locals.subtitulo) { %>
    <span class="subtitulo-portal"><%= subtitulo %></span>
<% } %>
</div>

<div id="overlay-menu"></div>


<!-- PESQUISA -->
<div class="search-bar">
    <button id="searchBtn" type="button" aria-label="Pesquisar"><i class="bi bi-search"></i></button>
    <input type="text" id="searchInput" name="q" placeholder="Pesquisar..." autocomplete="off" readonly onfocus="this.removeAttribute('readonly');">
</div>

<!-- MODAL DE PESQUISA (só aparece em telas pequenas, ver style.css) -->
<div id="modal-pesquisa" class="modal-pesquisa" aria-hidden="true">
    <div class="modal-pesquisa-box" role="dialog" aria-modal="true" aria-label="Pesquisar">
        <p class="modal-pesquisa-titulo">Pesquisar</p>
        <button type="button" id="fecharPesquisa" class="modal-pesquisa-fechar" aria-label="Fechar">&times;</button>
        <form id="formPesquisaModal" class="modal-pesquisa-form">
            <input type="search" id="searchInputModal" name="q" placeholder="Pesquisar..." autocomplete="off" enterkeyhint="search">
            <button type="submit" aria-label="Pesquisar"><i class="bi bi-search"></i></button>
        </form>
    </div>
</div>

<script>
(function () {
    var telaPequena = window.matchMedia("(max-width: 768px)");
    var modal = document.getElementById("modal-pesquisa");
    var inputModal = document.getElementById("searchInputModal");

    function irParaResultado(valor) {
        valor = (valor || "").trim();
        if (valor !== "") {
            window.location.href = "/pesquisa/resultado?q=" + encodeURIComponent(valor);
        } else {
            alert("Digite algo para pesquisar");
        }
    }

    function abrirModal() {
        modal.classList.add("aberto");
        modal.setAttribute("aria-hidden", "false");
        setTimeout(function () { inputModal.focus(); }, 50);
    }

    function fecharModal() {
        modal.classList.remove("aberto");
        modal.setAttribute("aria-hidden", "true");
    }

    // A barra está "recolhida" (só a lupa) em tela pequena OU quando a acessibilidade a deixa redonda
    function barraRecolhida() {
        return telaPequena.matches ||
               window.getComputedStyle(document.getElementById("searchInput")).display === "none";
    }

    // Botão da lupa: barra recolhida abre o modal; barra normal pesquisa direto
    document.getElementById("searchBtn").addEventListener("click", function () {
        if (barraRecolhida()) {
            abrirModal();
        } else {
            irParaResultado(document.getElementById("searchInput").value);
        }
    });

    // Enter na barra normal (tela grande)
    document.getElementById("searchInput").addEventListener("keypress", function (e) {
        if (e.key === "Enter") {
            irParaResultado(this.value);
        }
    });

    // Envio do formulário do modal (Enter ou botão da lupa)
    document.getElementById("formPesquisaModal").addEventListener("submit", function (e) {
        e.preventDefault();
        irParaResultado(inputModal.value);
    });

    // Fechar: botão X, clique fora da caixa, tecla Esc
    document.getElementById("fecharPesquisa").addEventListener("click", fecharModal);
    modal.addEventListener("click", function (e) {
        if (e.target === modal) fecharModal();
    });
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") fecharModal();
    });

    // Se a tela crescer com o modal aberto, fecha
    telaPequena.addEventListener("change", function (e) {
        if (!e.matches) fecharModal();
    });
})();

// Barra de pesquisa em bolinha só quando o cabeçalho está apertado (texto ampliado)
(function () {
    var header = document.querySelector("header");
    if (!header) return;
    var titulo = header.querySelector("h1");
    var subtitulo = header.querySelector(".subtitulo-portal");

    function ajustarBarra() {
        header.classList.remove("barra-bolinha"); // mede com a barra aberta

        // 1) o cabeçalho passou da largura da tela
        var estourou = header.scrollWidth > header.clientWidth + 1;

        // 2) o título precisou quebrar em duas linhas
        var tituloQuebrou = false;
        if (titulo) {
            var estilo = window.getComputedStyle(titulo);
            var linha = parseFloat(estilo.lineHeight) || parseFloat(estilo.fontSize) * 1.2;
            tituloQuebrou = titulo.offsetHeight > linha * 1.5;
        }

        // 3) o subtítulo ficou estreito demais para ler
        var subtituloApertado = false;
        if (subtitulo && window.getComputedStyle(subtitulo).display !== "none") {
            subtituloApertado = subtitulo.getBoundingClientRect().width < 150;
        }

        header.classList.toggle("barra-bolinha", estourou || tituloQuebrou || subtituloApertado);
    }

    ajustarBarra();
    window.addEventListener("load", ajustarBarra);
    window.addEventListener("resize", ajustarBarra);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(ajustarBarra);
    // roda de novo quando uma opção de acessibilidade muda
    new MutationObserver(ajustarBarra)
        .observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
})();
</script>
