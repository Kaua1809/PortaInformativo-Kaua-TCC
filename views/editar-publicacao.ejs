<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Postagem - Portal do Responsável</title>

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
       <link rel="stylesheet" href="/stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao_atualizado.css">
</head>

<body class="pagina-deficiencias">

<main class="main-nova-postagem">
    <div class="card-nova-postagem">
        <form id="form-postagem" action="/conta/publicacoes/<%= publicacao.id %>/editar" method="POST" enctype="multipart/form-data">
            <div class="form-layout-duplo">

                <!-- Coluna ESQUERDA: área de upload de mídia -->
                <div class="coluna-midia" id="drop-area">
                    <input
                        type="file"
                        name="imagem"
                        id="imagem"
                        accept="image/*,video/*"
                        onchange="previewImagem(this)"
                    >
                    <div class="preview-container" id="preview-container" style="<%= imagemBase64 ? '' : 'display:none;' %>">
                        <img id="image-preview" src="<%= imagemBase64 ? 'data:image/jpeg;base64,' + imagemBase64 : '#' %>" alt="Prévia da imagem">
                    </div>
                </div>

                <!-- Coluna DIREITA: avatar + legenda -->
                <div class="coluna-texto">
                    <div class="post-user-header">
                        <div class="post-user-avatar">
                            <img src="<%= (locals.usuarioLogado && usuarioLogado.foto_perfil) || FOTO_PADRAO %>" alt="Foto de Perfil">
                        </div>
                        <span class="post-user-name">
    <%= locals.usuarioLogado ? usuarioLogado.nome_exibicao : 'Utilizador' %>
</span>
                        
                    </div>

                    <textarea
                        name="texto"
                        id="texto"
                        class="form-control"
                        placeholder="Adicionar legenda..."
                        required
                    ><%= publicacao.comentarios %></textarea>
                    <div id="char-count" style="text-align: right; font-size: 14px; color: #666; margin-top: 5px;">0/500</div>

                </div>

            </div>

            <div class="botoes-container">
                <button type="submit" id="btn-publicar" class="btn-publicar">SALVAR</button>
                <a href="/conta" class="btn-voltar">VOLTAR</a>
            </div>

        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const LIMITE_CARACTERES = 500;

    const inputImagem = document.getElementById('imagem');
    const textareaTexto = document.getElementById('texto');
    const btnPublicar = document.getElementById('btn-publicar');
    const contadorTexto = document.getElementById('char-count');

        document.getElementById('form-postagem').addEventListener('submit', async function (e) {
        e.preventDefault();

        btnPublicar.disabled = true;
        btnPublicar.textContent = 'SALVANDO...';

        try {
            const resp = await fetch(this.action, {
                method: 'POST',
                body: new FormData(this)
            });

            // Se a rota respondeu com redirect, o fetch já seguiu: só navega para lá
            if (resp.redirected) {
                window.location.href = resp.url;
                return;
            }

            const dados = await resp.json();
            if (dados.sucesso) {
                window.location.href = '/conta';
            } else {
                throw new Error(dados.mensagem);
            }
        } catch (erro) {
            alert(erro.message || 'Erro ao salvar. Tente novamente.');
            btnPublicar.disabled = false;
            btnPublicar.textContent = 'SALVAR';
        }
    });

    function validarFormulario() {
        // Na edição a imagem é OPCIONAL: se não enviar uma nova, mantém a imagem já salva.
        const totalCaracteres = textareaTexto.value.length;
        const temTexto = textareaTexto.value.trim().length > 0;
        const dentroDoLimite = totalCaracteres <= LIMITE_CARACTERES;

        // Atualiza o contador visualmente
        contadorTexto.textContent = totalCaracteres + '/' + LIMITE_CARACTERES;
        if (!dentroDoLimite) {
            contadorTexto.style.color = 'red';
            contadorTexto.style.fontWeight = 'bold';
        } else {
            contadorTexto.style.color = '#666';
            contadorTexto.style.fontWeight = 'normal';
        }

        // Só habilita o botão se tiver texto E estiver dentro do limite (imagem não é obrigatória aqui)
        const podeSalvar = temTexto && dentroDoLimite;
        btnPublicar.disabled = !podeSalvar;
        btnPublicar.style.opacity = podeSalvar ? '1' : '0.5';
        btnPublicar.style.cursor = podeSalvar ? 'pointer' : 'not-allowed';
    }

    // Ouvintes de eventos para validar em tempo real
    inputImagem.addEventListener('change', validarFormulario);
    textareaTexto.addEventListener('input', validarFormulario);

    function previewImagem(input) {
        const container = document.getElementById('preview-container');
        const preview   = document.getElementById('image-preview');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                container.style.display = 'block';
                validarFormulario();
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            // Sem arquivo novo selecionado: mantém a prévia da imagem original (se houver)
            validarFormulario();
        }
    }

    // Inicializa o estado do botão e do contador ao carregar a página
    validarFormulario();
</script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
