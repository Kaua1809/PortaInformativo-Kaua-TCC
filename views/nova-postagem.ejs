<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Postagem - Portal do Responsável</title>

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
</head>

<body class="pagina-deficiencias">

<header>
    <%- include('partials/menu') %>
    <%- include('partials/navbar') %> 
</header>

<main class="main-nova-postagem">
    <div class="card-nova-postagem">
        <form action="/responsavel/criar-postagem" method="POST" enctype="multipart/form-data">
            <div class="form-layout-duplo">

                <!-- Coluna ESQUERDA: área de upload de mídia -->
                <div class="coluna-midia">
                    <label for="imagem">Adicionar imagem</label>
                    <input 
                        type="file" 
                        name="imagem" 
                        id="imagem" 
                        accept="image/*,video/*"
                        onchange="previewImagem(this)"
                    >
                    <div class="preview-container" id="preview-container">
                        <img id="image-preview" src="#" alt="Prévia da imagem">
                    </div>
                </div>

                <!-- Coluna DIREITA: avatar + legenda -->
                <div class="coluna-texto">
                    <!-- Cabeçalho com avatar e nome do utilizador da conta -->
                    <div class="post-user-header">
                        <div class="post-user-avatar">
                            <% 
                                // Ajustado para 'foto_perfil' conforme o seu código de rotas
                                if (locals.usuarioLogado && usuarioLogado.foto_perfil) { 
                            %>
                                <img src="<%= usuarioLogado.foto_perfil %>" alt="Foto de Perfil">
                            <% } else { %>
                                <!-- Ícone padrão caso não haja foto -->
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                                </svg>
                            <% } %>
                        </div>
                        <span class="post-user-name">
                            <% if (locals.usuarioLogado) { %>
                                <%= usuarioLogado.login %>
                            <% } else { %>
                                Utilizador
                            <% } %>
                        </span>
                    </div>

                    <!-- Textarea de legenda -->
                    <textarea 
                        name="texto" 
                        id="texto" 
                        class="form-control" 
                        placeholder="Adicionar legenda..."
                        required
                    ></textarea>
                </div>

            </div><!-- fim .form-layout-duplo -->

            <!-- Botões POSTAR e VOLTAR -->
            <div class="botoes-container">
                <button type="submit" class="btn-publicar">POSTAR</button>
                <a href="/responsavel" class="btn-voltar">VOLTAR</a>
            </div>

        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/javascripts/menu.js"></script>

<script>
    function previewImagem(input) {
        const container = document.getElementById('preview-container');
        const preview   = document.getElementById('image-preview');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                container.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            container.style.display = 'none';
        }
    }
</script>

</body>
</html>
