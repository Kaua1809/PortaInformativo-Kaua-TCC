<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Postagem - Portal do Responsável</title>

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
</head>

<body class="pagina-deficiencias">

<main class="main-nova-postagem">
    <div class="card-nova-postagem">
        <form id="form-postagem" action="/responsavel/criar-postagem" method="POST" enctype="multipart/form-data">
            <div class="form-layout-duplo">

                <!-- Coluna ESQUERDA: área de upload de mídia -->
                <div class="coluna-midia" id="drop-area">
                    <input  
                        type="file" 
                        name="imagem" 
                        id="imagem" 
                        accept="image/*,video/*"
                        onchange="previewImagem(this)"
                        required
                    >
                    <div class="preview-container" id="preview-container">
                        <img id="image-preview" src="#" alt="Prévia da imagem">
                    </div>
                </div>

                <!-- Coluna DIREITA: avatar + legenda -->
                <div class="coluna-texto">
                    <div class="post-user-header">
                        <div class="post-user-avatar">
                            <% if (locals.usuarioLogado && usuarioLogado.foto_perfil) { %>
                                <img src="<%= usuarioLogado.foto_perfil %>" alt="Foto de Perfil">
                            <% } else { %>
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                                </svg>
                            <% } %>
                        </div>
                        <span class="post-user-name">
                            <%= locals.usuarioLogado ? usuarioLogado.login : 'Utilizador' %>
                        </span>
                    </div>

                    <textarea 
                        name="texto" 
                        id="texto" 
                        class="form-control" 
                        placeholder="Adicionar legenda..."
                        required
                    ></textarea>
                    <div id="char-count" style="text-align: right; font-size: 14px; color: #666; margin-top: 5px;">0/500</div>

                </div>

            </div>

            <div class="botoes-container">
                <button type="submit" id="btn-publicar" class="btn-publicar" disabled>POSTAR</button>
                <a href="/responsavel" class="btn-voltar">VOLTAR</a>
            </div>

        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const LIMITE_CARACTERES = 500;

    const inputImagem = document.getElementById('imagem');
    const textareaTexto = document.getElementById('texto');
    const btnPublicar = document.getElementById('btn-publicar');
    const contadorTexto = document.getElementById('char-count');

    function validarFormulario() {
        const temImagem = inputImagem.files && inputImagem.files[0];
        const totalCaracteres = textareaTexto.value.length;
        const temTexto = textareaTexto.value.trim().length > 0;
        const dentroDoLimite = totalCaracteres <= LIMITE_CARACTERES;

        // Atualiza o contador visualmente
        contadorTexto.textContent = totalCaracteres + '/' + LIMITE_CARACTERES;
        if (!dentroDoLimite) {
            contadorTexto.style.color = 'red';
            contadorTexto.style.fontWeight = 'bold';
        } else {
            contadorTexto.style.color = '#666';
            contadorTexto.style.fontWeight = 'normal';
        }

        // Só habilita o botão se tiver imagem E texto E estiver dentro do limite
        const podePublicar = temImagem && temTexto && dentroDoLimite;
        btnPublicar.disabled = !podePublicar;
        btnPublicar.style.opacity = podePublicar ? '1' : '0.5';
        btnPublicar.style.cursor = podePublicar ? 'pointer' : 'not-allowed';
    }

    // Ouvintes de eventos para validar em tempo real
    inputImagem.addEventListener('change', validarFormulario);
    textareaTexto.addEventListener('input', validarFormulario);

    function previewImagem(input) {
        const container = document.getElementById('preview-container');
        const preview   = document.getElementById('image-preview');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                container.style.display = 'block';
                validarFormulario();
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            container.style.display = 'none';
            validarFormulario();
        }
    }

    // Inicializa o estado do botão e do contador ao carregar a página
    validarFormulario();
</script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>