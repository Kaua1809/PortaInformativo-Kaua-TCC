                <% noticiasRelacionadas.forEach(function(noticia) { %>
                    <div class="card">
                        <a href="/noticias/<%= noticia.id %>">
                            <% if (noticia.foto) { %>
                                <img src="data:image/jpeg;base64,<%= noticia.foto.toString('base64') %>" alt="<%= noticia.titulo %>">
                            <% } else { %>
                                <img src="/images/fotonot1.png" alt="<%= noticia.titulo %>">
                            <% } %>
