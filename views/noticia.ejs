<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : noticia.titulo %></title>
    <link rel="stylesheet" href="/stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
    <link rel="stylesheet" href="/stylesheets/noticias.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    
</head>
<body>

    <main class="noticia-container">

        <div class="area-voltar-noticia">
            <a href="/" class="btn-voltar-noticia"><i class="fas fa-arrow-left"></i> VOLTAR</a>
        </div>

        <% if (noticia.foto) { %>
            <img class="noticia-foto" src="data:image/jpeg;base64,<%= noticia.foto.toString('base64') %>" alt="<%= noticia.titulo %>">
        <% } %>

        <h1 class="noticia-titulo"><%= noticia.titulo %></h1>

        <div class="noticia-meta">
            <% if (noticia.autor_login) { %>
                <span><i class="fas fa-user"></i> <%= noticia.autor_login %></span>
            <% } %>
            <span><i class="fas fa-calendar"></i> <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR') %></span>
        </div>

        <% if (noticia.descricao) { %>
            <p class="noticia-descricao"><%= noticia.descricao %></p>
        <% } %>

        <div class="conteudo-artigo">
            <% if (blocos && blocos.length > 0) { %>
                <% blocos.forEach(function(bloco) { %>
                    <div class="noticia-bloco <%= bloco.tipo_texto === 'citacao' ? 'bloco-tipo-citacao' : '' %>">
                        
                        <% if (bloco.tipo_texto === 'galeria') { %>
                            <% let galData = { cols: '3', altura: 'media', imagens: [] }; %>
                            <% try { if (bloco.texto) galData = JSON.parse(bloco.texto); } catch(e) {} %>
                            <% const galeriaImgs = bloco.galeriaImagens || []; %>
                            <% if (galeriaImgs.length > 0) { %>
                            <div class="preview-galeria cols-<%= galData.cols || '3' %> altura-<%= galData.altura || 'media' %>">
                                <% galeriaImgs.forEach(function(img, gi) { %>
                                    <% const altImg = (galData.imagens && galData.imagens[gi]) ? (galData.imagens[gi].alt || '') : ''; %>
                                    <img src="data:image/jpeg;base64,<%= img.imagem.toString('base64') %>" alt="<%= altImg %>">
                                <% }); %>
                            </div>
                            <% } %>
                        <% } else if (bloco.imagem) { %>
                            <% const tam = bloco.imagem_tamanho || 'grande'; %>
                            <% const ori = bloco.imagem_orientacao || 'horizontal'; %>
                            <figure>
                                <img src="data:image/jpeg;base64,<%= bloco.imagem.toString('base64') %>"
                                     alt="<%= bloco.imagem_alt || '' %>"
                                     class="img-tamanho-<%= tam %> img-orientacao-<%= ori %>">
                                <% if (bloco.imagem_fonte) { %>
                                    <figcaption class="legenda-imagem">Fonte: <%= bloco.imagem_fonte %></figcaption>
                                <% } %>
                            </figure>
                        <% } %>

                        <% if (bloco.tipo_texto === 'separador') { %>
                            <hr>
                        <% } else if (bloco.tipo_texto !== 'galeria' && bloco.texto) { %>
                            <div class="conteudo-texto-view <%= bloco.tipo_texto === 'subtitulo' ? 'noticia-subtitulo' : '' %>">
                                <%- bloco.texto %>
                            </div>
                        <% } %>

                        <% if (bloco.tipo_texto === 'citacao' && bloco.citacao_autor) { %>
                            <span class="autor-citacao-view"><%= bloco.citacao_autor %></span>
                        <% } %>

                    </div>
                <% }); %>
            <% } %>
        </div>

        <% if (usuarioLogado && usuarioLogado.is_admin) { %>
            <div class="noticia-acoes-admin">
                <a href="/noticias/<%= noticia.id %>/editar" class="btn-editar-noticia"><i class="fas fa-edit"></i> Editar</a>
                <button type="button" class="btn-excluir-noticia" onclick="excluirNoticia(<%= noticia.id %>)"><i class="fas fa-trash"></i> Excluir</button>
            </div>
        <% } %>

    </main>

    <!-- Modal genérico de confirmação -->
    <div id="modal-confirmar-acao" class="modal-container">
        <div class="modal-box" style="max-width: 400px;">
            <h1><i class="fas fa-question-circle"></i> Confirmar</h1>
            <p id="texto-confirmar-acao">Tem certeza?</p>
           <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
                <button class="enviar" id="confirmar-acao-sim" type="button">Sim, confirmar</button>
               <button class="fechar" id="fechar" type="button" onclick="fecharModalConfirmacao()">Cancelar</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast-aviso" style="
        position: fixed; bottom: 30px; right: 30px; z-index: 2000;
        background: #34495e; color: #fff; padding: 14px 22px;
        border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        font-size: 0.95rem; display: none; max-width: 320px;">
    </div>

    <script>
        function mostrarToast(mensagem, sucesso) {
            const toast = document.getElementById('toast-aviso');
            toast.textContent = mensagem;
            toast.style.background = sucesso ? '#34495e' : '#e74c3c';
            toast.style.display = 'block';
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(() => { toast.style.display = 'none'; }, 4000);
        }

        function fecharModalConfirmacao() {
            document.getElementById('modal-confirmar-acao').classList.remove('mostrar');
        }

        function pedirConfirmacao(texto, aoConfirmar) {
            document.getElementById('texto-confirmar-acao').textContent = texto;
            document.getElementById('modal-confirmar-acao').classList.add('mostrar');

            const botaoSim = document.getElementById('confirmar-acao-sim');
            const novoBotao = botaoSim.cloneNode(true); // remove listeners antigos
            botaoSim.parentNode.replaceChild(novoBotao, botaoSim);

            novoBotao.addEventListener('click', function () {
                if (novoBotao.disabled) return;
                novoBotao.disabled = true;
                fecharModalConfirmacao();
                aoConfirmar();
            });
        }

        function excluirNoticia(id) {
            pedirConfirmacao('Excluir esta notícia permanentemente?', function () {
                fetch('/noticias/' + id, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.sucesso) {
                            mostrarToast('Notícia excluída.', true);
                            setTimeout(() => { window.location.href = '/'; }, 1000);
                        } else {
                            mostrarToast(data.mensagem || 'Não foi possível excluir.', false);
                        }
                    })
                    .catch(() => mostrarToast('Erro de conexão ao excluir.', false));
            });
        }
    </script>
    <%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
