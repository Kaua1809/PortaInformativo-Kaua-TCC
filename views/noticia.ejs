<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : noticia.titulo %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
    <link rel="stylesheet" href="/stylesheets/noticias.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    
</head>
<body>

    <main class="noticia-container">

        <div class="area-voltar-noticia">
            <a href="/" class="btn-voltar-noticia"><i class="fas fa-arrow-left"></i> VOLTAR</a>
        </div>

        <% if (noticia.foto) { %>
            <img class="noticia-foto" src="data:image/jpeg;base64,<%= noticia.foto.toString('base64') %>" alt="<%= noticia.titulo %>">
        <% } %>

        <h1 class="noticia-titulo"><%= noticia.titulo %></h1>

        <div class="noticia-meta">
            <% if (noticia.autor_login) { %>
                <span><i class="fas fa-user"></i> <%= noticia.autor_login %></span>
            <% } %>
            <span><i class="fas fa-calendar"></i> <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR') %></span>
        </div>

        <% if (noticia.descricao) { %>
            <p class="noticia-descricao"><%= noticia.descricao %></p>
        <% } %>

        <div class="conteudo-artigo">
            <% if (blocos && blocos.length > 0) { %>
                <% blocos.forEach(function(bloco) { %>
                    <div class="noticia-bloco <%= bloco.tipo_texto === 'citacao' ? 'bloco-tipo-citacao' : '' %>">
                        
                        <% if (bloco.tipo_texto === 'galeria') { %>
                            <% let galData = { cols: '3', altura: 'media', imagens: [] }; %>
                            <% try { if (bloco.texto) galData = JSON.parse(bloco.texto); } catch(e) {} %>
                            <% const galeriaImgs = bloco.galeriaImagens || []; %>
                            <% if (galeriaImgs.length > 0) { %>
                            <div class="preview-galeria cols-<%= galData.cols || '3' %> altura-<%= galData.altura || 'media' %>">
                                <% galeriaImgs.forEach(function(img, gi) { %>
                                    <% const altImg = (galData.imagens && galData.imagens[gi]) ? (galData.imagens[gi].alt || '') : ''; %>
                                    <img src="data:image/jpeg;base64,<%= img.imagem.toString('base64') %>" alt="<%= altImg %>">
                                <% }); %>
                            </div>
                            <% } %>
                        <% } else if (bloco.imagem) { %>
                            <% const tam = bloco.imagem_tamanho || 'grande'; %>
                            <% const ori = bloco.imagem_orientacao || 'horizontal'; %>
                            <figure>
                                <img src="data:image/jpeg;base64,<%= bloco.imagem.toString('base64') %>"
                                     alt="<%= bloco.imagem_alt || '' %>"
                                     class="img-tamanho-<%= tam %> img-orientacao-<%= ori %>">
                                <% if (bloco.imagem_fonte) { %>
                                    <figcaption class="legenda-imagem">Fonte: <%= bloco.imagem_fonte %></figcaption>
                                <% } %>
                            </figure>
                        <% } %>

                        <% if (bloco.tipo_texto === 'separador') { %>
                            <hr>
                        <% } else if (bloco.tipo_texto !== 'galeria' && bloco.texto) { %>
                            <div class="conteudo-texto-view <%= bloco.tipo_texto === 'subtitulo' ? 'noticia-subtitulo' : '' %>">
                                <%- bloco.texto %>
                            </div>
                        <% } %>

                        <% if (bloco.tipo_texto === 'citacao' && bloco.citacao_autor) { %>
                            <span class="autor-citacao-view"><%= bloco.citacao_autor %></span>
                        <% } %>

                    </div>
                <% }); %>
            <% } %>
        </div>

        <% if (usuarioLogado && usuarioLogado.is_admin) { %>
            <div class="noticia-acoes-admin">
                <a href="/noticias/<%= noticia.id %>/editar" class="btn-editar-noticia"><i class="fas fa-edit"></i> Editar</a>
                <button type="button" class="btn-excluir-noticia" onclick="excluirNoticia(<%= noticia.id %>)"><i class="fas fa-trash"></i> Excluir</button>
            </div>
        <% } %>

    </main>

    <script>
        function excluirNoticia(id) {
            if (!confirm('Excluir esta notícia permanentemente?')) return;

            fetch('/noticias/' + id, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.sucesso) {
                        window.location.href = '/';
                    } else {
                        alert(data.mensagem || 'Não foi possível excluir.');
                    }
                })
                .catch(() => alert('Erro de conexão ao excluir.'));
        }
    </script>
    <%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
