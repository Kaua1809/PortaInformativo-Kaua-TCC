<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal do Responsável</title>

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="stylesheets/style.css">
       <link rel="stylesheet" href="stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
    <link rel="stylesheet" href="/stylesheets/responsavel.css">



</head>

<body class="pagina-deficiencias pagina-feed">

<header>
    <%- include('partials/menu' ) %>
    <%- include('partials/navbar') %> 
</header>

<main id="main-portal">

    <section id="container-portal">

        <!-- ================= FEED ================= -->
        <section id="feed-completo">

            <% if (postagens && postagens.length > 0) { %>
                <% postagens.forEach(post => { %>

                    <article class="post-completo" data-post-id="<%= post.id %>">
    <div class="post-layout-horizontal">
        <!-- Lado Esquerdo: Imagem -->
        <div class="post-coluna-imagem">
            <% if (post.fotos) { %>
                <img src="data:image/jpeg;base64,<%= post.fotos.toString('base64') %>" alt="Imagem do post" class="post-imagem">
            <% } %>
        </div>

        <!-- Lado Direito: Perfil e Legenda -->
        <div class="post-coluna-conteudo">
            <div class="post-topo">
                <% if (post.foto_perfil) { %>
                    <img src="<%= post.foto_perfil %>" alt="Avatar" class="avatar">
                <% } else { %>
                    <div class="avatar"></div>
                <% } %>
                <div>
                    <h4 class="nome-usuario"><a href="/responsavel/perfil/<%= post.usuario_id %>" style="color: inherit; text-decoration: none;"><%= post.nome_exibicao %></a></h4>
                    <small class="data-postagem"><%= new Date(post.data_postagem).toLocaleDateString('pt-BR') %></small>
                </div>
            </div>

            <div class="post-corpo">
                <div class="post-texto-container">
                    <p><%= post.comentarios %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Parte Inferior: Botões de Ação (Abaixo da imagem) -->
    <div class="post-acoes">
        <button class="btn-acao btn-comentar" onclick="irParaDetalhes('<%= post.id %>')">
            <i class="fas fa-comment"></i> <%= post.total_comentarios %>
        </button>

        <button class="btn-acao btn-curtir <%= post.usuario_curtiu > 0 ? 'curtido' : '' %>"
                onclick="curtirPostagem('<%= post.id %>', this)"
                data-curtido="<%= post.usuario_curtiu > 0 ? 'true' : 'false' %>">
            <i class="fas fa-heart"></i> <%= post.total_curtidas %>
        </button>

        <button class="btn-acao btn-denunciar" onclick="abrirModalDenuncia('<%= post.id %>')">
            <i class="fas fa-exclamation-triangle"></i> Denunciar
        </button>

        <% if (usuarioLogado.is_admin) { %>
            <button class="btn-acao btn-excluir-admin" onclick="excluirPostagemAdmin('<%= post.id %>')" title="Excluir postagem (Admin)" style="color: #e74c3c;">
                <i class="fas fa-trash"></i>
            </button>
        <% } %>
    </div>
</article>
                <% }); %>
            <% } else { %>
                <p class="text-center">Nenhuma postagem disponível no momento.</p>
            <% } %>

        </section>

        <!-- ================= SIDEBAR ================= -->
        <aside id="sidebar-completo">

            <div class="perfil-box">

                <% if (usuarioLogado.foto_perfil) { %>
                    <img src="<%= usuarioLogado.foto_perfil %>" alt="Avatar" class="avatar-grande">
                <% } else { %>
                    <div class="avatar-grande"></div>
                <% } %>

                <h4><%= usuarioLogado.nome_exibicao %></h4>

              

            </div>

            <div class="acoes-lateral">

                <a href="#" onclick="openModal('modal-contato')" class="btn-lateral" id="abrirContato">
                    Contato
                </a>

                <a href="#" onclick="openModal('modal-feedback')" class="btn-lateral">Feedback</a>

                <a href="ajuda.html" class="btn-lateral">Ajuda</a>

                <a href="/responsavel/criar-postagem" class="btn-lateral">+</a>

            </div>

        </aside>

    </section>

</main>

<!-- ================= MODAIS ================= -->
<%- include('partials/modal-contato') %> 
<%- include('partials/modal-feedback') %> 

<!-- Modal para Denúncia (mesmo padrão visual do modal de Contato/Feedback) -->
<div id="modal-denuncia-postagem" class="modal-container">
    <div class="modal-box">

        <h1><i class="fas fa-exclamation-triangle"></i> Denunciar Postagem</h1>

        <p>Selecione o motivo da denúncia. Sua denúncia será analisada pela nossa equipe.</p>

        <form class="form-contato" id="form-denuncia-postagem">

            <div class="campo-mensagem">
                <label class="label-contato" for="denuncia-postagem-motivo">Motivo:</label>
                <select class="input-contato" id="denuncia-postagem-motivo" name="motivo" required>
                    <option value="">Selecione um motivo</option>
                    <option value="conteudo-ofensivo">Conteúdo ofensivo</option>
                    <option value="spam">Spam</option>
                    <option value="conteudo-inapropriado">Conteúdo inapropriado</option>
                    <option value="outro">Outro</option>
                </select>
            </div>

            <div class="campo-mensagem">
                <label class="label-contato" for="denuncia-postagem-descricao">Descrição (opcional):</label>
                <textarea class="input-mensagem" id="denuncia-postagem-descricao" name="descricao"></textarea>
            </div>

            <div class="modal-footer">
                <button class="enviar" id="enviar-denuncia-postagem" type="button">Denunciar</button>
                <button class="fechar" id="fechar" type="button">Fechar</button>
            </div>

        </form>

    </div>
</div>

<!-- Modal genérico de confirmação (substitui os confirm() do navegador) -->
<div id="modal-confirmar-acao" class="modal-container">
    <div class="modal-box" style="max-width: 400px;">
        <h1><i class="fas fa-question-circle"></i> Confirmar</h1>
        <p id="texto-confirmar-acao">Tem certeza?</p>
        <div class="modal-footer">
            <button class="enviar" id="confirmar-acao-sim" type="button">Sim, confirmar</button>
            <button class="fechar" id="fechar" type="button">Cancelar</button>
        </div>
    </div>
</div>

<!-- Toast (substitui os alert() do navegador) -->
<div id="toast-aviso" style="
    position: fixed; bottom: 30px; right: 30px; z-index: 2000;
    background: #34495e; color: #fff; padding: 14px 22px;
    border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    font-size: 0.95rem; display: none; max-width: 320px;">
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="javascripts/menu.js"></script>
<script src="javascripts/modal-contato.js"></script>
<script src="javascripts/modal-feedback.js"></script>


<script>
    let postIdAtual = null;

    /* ---------- Toast (substitui alert()) ---------- */
    function mostrarToast(mensagem, sucesso) {
        const toast = document.getElementById('toast-aviso');
        toast.textContent = mensagem;
        toast.style.background = sucesso ? '#34495e' : '#e74c3c';
        toast.style.display = 'block';
        clearTimeout(toast._timeout);
        toast._timeout = setTimeout(() => { toast.style.display = 'none'; }, 4000);
    }

    /* ---------- Confirmação (substitui confirm()) ---------- */
    function pedirConfirmacao(texto, aoConfirmar) {
        document.getElementById('texto-confirmar-acao').textContent = texto;
        openModal('modal-confirmar-acao');

        const botaoSim = document.getElementById('confirmar-acao-sim');
        const novoBotao = botaoSim.cloneNode(true); // remove listeners antigos
        botaoSim.parentNode.replaceChild(novoBotao, botaoSim);

        novoBotao.addEventListener('click', function() {
            if (novoBotao.disabled) return;
            novoBotao.disabled = true;
            document.getElementById('modal-confirmar-acao').classList.remove('mostrar');
            aoConfirmar();
        });
    }

    // Função para curtir/descurtir postagem (instantâneo, sem reload — igual comentario.ejs)
    function curtirPostagem(postId, botao) {
        fetch('/responsavel/curtir/' + postId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ tipo: 'postagem' })
        })
        .then(response => response.json())
        .then(data => {
            if (!data.sucesso) {
                mostrarToast('Não foi possível curtir.', false);
                return;
            }

            const curtiu = data.acao === 'curtida';
            botao.classList.toggle('curtido', curtiu);
            botao.dataset.curtido = curtiu ? 'true' : 'false';

            // Atualiza o número ao lado do ícone (texto do botão após o <i>)
            const partes = botao.textContent.trim().split(/\s+/);
            let total = parseInt(partes[partes.length - 1], 10) || 0;
            total = curtiu ? total + 1 : Math.max(0, total - 1);

            // Substitui só o número, mantendo o ícone <i> intacto
            const icone = botao.querySelector('i');
            botao.innerHTML = '';
            botao.appendChild(icone);
            botao.append(' ' + total);
        })
        .catch(error => console.error('Erro:', error));
    }

    // Função para ir para a página de detalhes (comentario.ejs)
    function irParaDetalhes(postId) {
        window.location.href = '/responsavel/comentario/' + postId;
    }


    // Função para abrir modal de denúncia
    function abrirModalDenuncia(postId) {
        postIdAtual = postId;
        openModal('modal-denuncia-postagem');
    }

    // Envio da denúncia de postagem
    document.getElementById('enviar-denuncia-postagem').addEventListener('click', function() {
        const motivo = document.getElementById('denuncia-postagem-motivo').value;
        const descricao = document.getElementById('denuncia-postagem-descricao').value;

        if (!motivo) {
            mostrarToast('Por favor, selecione um motivo.', false);
            return;
        }

        fetch('/responsavel/denunciar/' + postIdAtual, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                tipo: 'postagem',
                motivo: motivo + (descricao ? ' - ' + descricao : '')
            })
        })
        .then(response => response.json())
        .then(data => {
            mostrarToast(data.mensagem || (data.sucesso ? 'Denúncia enviada.' : 'Não foi possível enviar a denúncia.'), data.sucesso);
            if (data.sucesso) {
                document.getElementById('modal-denuncia-postagem').classList.remove('mostrar');
                document.getElementById('form-denuncia-postagem').reset();
            }
        })
        .catch(error => console.error('Erro:', error));
    });

    // Excluir postagem (ação de administrador)
    function excluirPostagemAdmin(postId) {
        pedirConfirmacao('Excluir esta postagem permanentemente? (ação de administrador)', function() {
            fetch('/admin/postagem/' + postId, { method: 'DELETE' })
                .then(response => response.json())
                .then(data => {
                    mostrarToast(data.mensagem || (data.sucesso ? 'Postagem excluída.' : 'Não foi possível excluir.'), data.sucesso);
                    if (data.sucesso) {
                        document.querySelector('.post-completo[data-post-id="' + postId + '"]').remove();
                    }
                })
                .catch(error => console.error('Erro:', error));
        });
    }
</script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
