<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
       <link rel="stylesheet" href="/stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="/stylesheets/portalinclusao.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <main id="comentario-container">
        <!-- ÁREA DA POSTAGEM -->
        <div class="post-wrapper">
            <div class="post-col-imagem">
                <% if (postagem.fotos) { %>
                    <img src="data:image/jpeg;base64,<%= postagem.fotos.toString('base64') %>" alt="Post">
                <% } %>
            </div>

            <div class="post-col-info">
                <div class="perfil-header">
                    <img src="<%= postagem.foto_perfil || FOTO_PADRAO %>" class="avatar-img" alt="Avatar">
                    <span class="nome-autor"><a href="/responsavel/perfil/<%= postagem.id_portal %>" style="color: inherit; text-decoration: none;"><%= postagem.nome_exibicao %></a></span>
                </div>
                <p class="texto-post"><%= postagem.comentarios %></p>
            </div>
        </div>

        <!-- BOTÃO VOLTAR: alinhado ao canto direito, acima da linha que separa os comentários -->
        <div class="area-voltar-topo">
            <a href="/responsavel" class="btn-voltar-custom">VOLTAR</a>
        </div>

        <!-- TRIGGER COMENTAR -->
        <div class="trigger-comentario" id="trigger-comentario">
            <i class="fas fa-comment"></i> Comentar
        </div>

        <!-- CAIXA PARA NOVO COMENTÁRIO -->
        <div class="caixa-novo-comentario" id="caixa-novo-comentario">
            <textarea id="texto-novo-comentario" placeholder="Escreva um comentário..."></textarea>
            <button class="btn-enviar-comentario" id="btn-enviar-comentario" disabled>Enviar</button>
        </div>

        <!-- LISTA DE COMENTÁRIOS RAIZ -->
        <div class="comentarios-secao">
            <% if (comentarios && comentarios.length > 0) { %>
                <% comentarios.forEach(comentario => { %>
                    <div class="comentario-card" id="comentario-card-<%= comentario.id %>">
                        <img src="<%= comentario.foto_perfil || FOTO_PADRAO %>" class="avatar-img" alt="Avatar">
                        <div class="comentario-corpo">
                            <strong><a href="/responsavel/perfil/<%= comentario.usuario_id %>" style="color: inherit; text-decoration: none;"><%= comentario.nome_exibicao %></a></strong>
                            <p><%= comentario.texto_comentario %></p>
                            <div class="comentario-acoes">
                                <button type="button" class="btn-resp" data-comentario-id="<%= comentario.id %>">Responder</button>

                                <% if (comentario.total_respostas > 0) { %>
                                    <button type="button" class="btn-ver-respostas" data-comentario-id="<%= comentario.id %>">
                                        Respostas (<%= comentario.total_respostas %>)
                                    </button>
                                <% } %>

                                <button type="button"
                                    class="acao-icone btn-denunciar"
                                    data-id="<%= comentario.id %>"
                                    data-tipo="comentario"
                                    title="Denunciar">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </button>

                                <button type="button"
                                    class="acao-icone btn-curtir <%= comentario.usuario_curtiu > 0 ? 'curtido' : '' %>"
                                    data-id="<%= comentario.id %>"
                                    data-tipo="comentario"
                                    title="Curtir">
                                    <i class="fas fa-heart"></i>
                                    <span class="contador-curtidas"><%= comentario.total_curtidas > 0 ? comentario.total_curtidas : '' %></span>
                                </button>

                                <% if (comentario.pode_excluir) { %>
                                    <button type="button"
                                        class="acao-icone btn-excluir-comentario"
                                        data-id="<%= comentario.id %>"
                                        title="Excluir">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                <% } else if (usuarioLogado.is_admin) { %>
                                    <button type="button"
                                        class="acao-icone btn-excluir-comentario-admin"
                                        data-id="<%= comentario.id %>"
                                        title="Excluir (Admin)"
                                        style="color: #e74c3c;">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                <% } %>
                            </div>

                            <!-- CAIXA DE RESPOSTA -->
                            <div class="caixa-resposta" id="resposta-<%= comentario.id %>">
                                <textarea placeholder="Escreva uma resposta..."></textarea>
                                <button class="btn-enviar-resposta" disabled>Enviar</button>
                            </div>

                            <!-- LISTA DE RESPOSTAS (carregada via fetch) -->
                            <div class="lista-respostas" id="lista-respostas-<%= comentario.id %>"
                                 data-postagem-id="<%= postagem.id %>"></div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; color: #666;">Nenhum comentário ainda.</p>
            <% } %>
        </div>

        <!-- Modal para Denúncia (mesmo padrão visual do modal de Contato/Feedback) -->
        <div id="modal-denuncia-comentario" class="modal-container">
            <div class="modal-box">

                <h1><i class="fas fa-exclamation-triangle"></i> Denunciar</h1>

                <p>Selecione o motivo da denúncia. Sua denúncia será analisada pela nossa equipe.</p>

                <form class="form-contato" id="form-denuncia-comentario">

                    <div class="campo-mensagem">
                        <label class="label-contato" for="denuncia-comentario-motivo">Motivo:</label>
                        <select class="input-contato" id="denuncia-comentario-motivo" name="motivo" required>
                            <option value="">Selecione um motivo</option>
                            <option value="conteudo-ofensivo">Conteúdo ofensivo</option>
                            <option value="spam">Spam</option>
                            <option value="conteudo-inapropriado">Conteúdo inapropriado</option>
                            <option value="outro">Outro</option>
                        </select>
                    </div>

                    <div class="campo-mensagem">
                        <label class="label-contato" for="denuncia-comentario-descricao">Descrição (opcional):</label>
                        <textarea class="input-mensagem" id="denuncia-comentario-descricao" name="descricao"></textarea>
                    </div>

                    <div class="modal-footer">
                        <button class="enviar" id="enviar-denuncia-comentario" type="button">Denunciar</button>
                        <button class="fechar" id="fechar" type="button">Fechar</button>
                    </div>

                </form>

            </div>
        </div>

        <!-- Modal genérico de confirmação (substitui os confirm() do navegador) -->
        <div id="modal-confirmar-acao" class="modal-container">
            <div class="modal-box" style="max-width: 400px;">
                <h1><i class="fas fa-question-circle"></i> Confirmar</h1>
                <p id="texto-confirmar-acao">Tem certeza?</p>
                <div class="modal-footer">
                    <button class="enviar" id="confirmar-acao-sim" type="button">Sim, confirmar</button>
                    <button class="fechar" id="fechar" type="button">Cancelar</button>
                </div>
            </div>
        </div>

        <!-- Toast (substitui os alert() do navegador) -->
        <div id="toast-aviso" style="
            position: fixed; bottom: 30px; right: 30px; z-index: 2000;
            background: #34495e; color: #fff; padding: 14px 22px;
            border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            font-size: 0.95rem; display: none; max-width: 320px;">
        </div>

    </main>

    <script src="/javascripts/modal-contato.js"></script>
    <script>
        const FOTO_PADRAO = <%- JSON.stringify(FOTO_PADRAO) %>;
        const POSTAGEM_ID = <%= postagem.id %>;
        const NOME_USUARIO_LOGADO = <%- JSON.stringify(usuarioLogado.nome_exibicao) %>;
        const FOTO_USUARIO_LOGADO = <%- JSON.stringify(usuarioLogado.foto_perfil || FOTO_PADRAO) %>;
        const USUARIO_LOGADO_ADMIN = <%- JSON.stringify(!!usuarioLogado.is_admin) %>;

        let idDenunciaAtual = null;
        let tipoDenunciaAtual = null;

        /* ---------- Toast (substitui alert()) ---------- */
        function mostrarToast(mensagem, sucesso) {
            const toast = document.getElementById('toast-aviso');
            toast.textContent = mensagem;
            toast.style.background = sucesso ? '#34495e' : '#e74c3c';
            toast.style.display = 'block';
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(() => { toast.style.display = 'none'; }, 4000);
        }

        /* ---------- Confirmação (substitui confirm()) ---------- */
        function pedirConfirmacao(texto, aoConfirmar) {
            document.getElementById('texto-confirmar-acao').textContent = texto;
            openModal('modal-confirmar-acao');

            const botaoSim = document.getElementById('confirmar-acao-sim');
            const novoBotao = botaoSim.cloneNode(true); // remove listeners antigos
            botaoSim.parentNode.replaceChild(novoBotao, botaoSim);

            novoBotao.addEventListener('click', function() {
                if (novoBotao.disabled) return;
                novoBotao.disabled = true;
                document.getElementById('modal-confirmar-acao').classList.remove('mostrar');
                aoConfirmar();
            });
        }

        document.getElementById('enviar-denuncia-comentario').addEventListener('click', function() {
            const motivo = document.getElementById('denuncia-comentario-motivo').value;
            const descricao = document.getElementById('denuncia-comentario-descricao').value;

            if (!motivo) {
                mostrarToast('Por favor, selecione um motivo.', false);
                return;
            }

            fetch('/responsavel/denunciar/' + idDenunciaAtual, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tipo: tipoDenunciaAtual,
                    motivo: motivo + (descricao ? ' - ' + descricao : '')
                })
            })
            .then(res => res.json())
            .then(data => {
                mostrarToast(data.mensagem || (data.sucesso ? 'Denúncia enviada. Obrigado por ajudar a manter a comunidade segura.' : 'Não foi possível enviar a denúncia.'), data.sucesso);
                if (data.sucesso) {
                    document.getElementById('modal-denuncia-comentario').classList.remove('mostrar');
                    document.getElementById('form-denuncia-comentario').reset();
                }
            })
            .catch(() => mostrarToast('Erro de conexão ao denunciar.', false));
        });

        /* ---------- Abrir/fechar caixa de novo comentário (raiz) ---------- */
        const triggerComentario = document.getElementById('trigger-comentario');
        const caixaNovoComentario = document.getElementById('caixa-novo-comentario');
        const textoNovoComentario = document.getElementById('texto-novo-comentario');
        const btnEnviarComentario = document.getElementById('btn-enviar-comentario');

        triggerComentario.addEventListener('click', function() {
            caixaNovoComentario.classList.toggle('aberto');
            if (caixaNovoComentario.classList.contains('aberto')) {
                textoNovoComentario.focus();
            }
        });

        textoNovoComentario.addEventListener('input', function() {
            btnEnviarComentario.disabled = textoNovoComentario.value.trim().length === 0;
        });

        btnEnviarComentario.addEventListener('click', function() {
            const texto = textoNovoComentario.value.trim();
            enviarComentario(POSTAGEM_ID, texto, null, function(data) {
                // Insere o comentário novo no topo da lista, sem recarregar a página
                const secao = document.querySelector('.comentarios-secao');
                const vazio = secao.querySelector('p');
                if (vazio) vazio.remove();

                const wrapper = document.createElement('div');
                wrapper.innerHTML = montarHtmlComentarioRaiz({
                    id: data.id,
                    login: NOME_USUARIO_LOGADO,
                    foto_perfil: FOTO_USUARIO_LOGADO,
                    texto_comentario: texto
                });
                const card = wrapper.firstElementChild;
                secao.insertBefore(card, secao.firstChild);
                ativarAcoesComentario(card);

                // Limpa e fecha a caixa de novo comentário
                textoNovoComentario.value = '';
                btnEnviarComentario.disabled = true;
                caixaNovoComentario.classList.remove('aberto');
            });
        });

        function montarHtmlComentarioRaiz(c) {
            const avatar = c.foto_perfil || FOTO_PADRAO;
            return `
                <div class="comentario-card" id="comentario-card-${c.id}">
                    <img src="${escapeHtml(avatar)}" class="avatar-img" alt="Avatar">
                    <div class="comentario-corpo">
                        <strong>${escapeHtml(c.login)}</strong>
                        <p>${escapeHtml(c.texto_comentario)}</p>
                        <div class="comentario-acoes">
                            <button type="button" class="btn-resp" data-comentario-id="${c.id}">Responder</button>
                            <button type="button" class="acao-icone btn-denunciar" data-id="${c.id}" data-tipo="comentario" title="Denunciar">
                                <i class="fas fa-exclamation-triangle"></i>
                            </button>
                            <button type="button" class="acao-icone btn-curtir" data-id="${c.id}" data-tipo="comentario" title="Curtir">
                                <i class="fas fa-heart"></i>
                                <span class="contador-curtidas"></span>
                            </button>
                            <button type="button" class="acao-icone btn-excluir-comentario" data-id="${c.id}" title="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        <div class="caixa-resposta" id="resposta-${c.id}">
                            <textarea placeholder="Escreva uma resposta..."></textarea>
                            <button class="btn-enviar-resposta" disabled>Enviar</button>
                        </div>
                        <div class="lista-respostas" id="lista-respostas-${c.id}" data-postagem-id="${POSTAGEM_ID}"></div>
                    </div>
                </div>
            `;
        }

        // Liga os eventos (responder, curtir, denunciar) de um comentário-card recém-criado
        function ativarAcoesComentario(card) {
            const btnResp = card.querySelector('.btn-resp');
            btnResp.addEventListener('click', function() {
                const id = btnResp.getAttribute('data-comentario-id');
                const caixa = document.getElementById('resposta-' + id);
                caixa.classList.toggle('aberto');
                if (caixa.classList.contains('aberto')) {
                    caixa.querySelector('textarea').focus();
                }
            });

            const caixaResp = card.querySelector('.caixa-resposta');
            ativarCaixaResposta(caixaResp);

            ativarAcoesIcones(card);
        }

        /* ---------- Função genérica de enviar comentário/resposta ---------- */
        function enviarComentario(postId, texto, comentarioPaiId, aoSucesso) {
            if (!texto) return;

            fetch('/responsavel/comentar/' + postId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ texto: texto, comentario_pai_id: comentarioPaiId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    if (aoSucesso) aoSucesso(data);
                } else {
                    mostrarToast('Não foi possível enviar. Tente novamente.', false);
                }
            })
            .catch(() => mostrarToast('Erro de conexão ao enviar.', false));
        }

        /* ---------- Ativa as caixas de resposta já renderizadas pelo EJS ---------- */
        document.querySelectorAll('.caixa-resposta').forEach(function(caixa) {
            ativarCaixaResposta(caixa);
        });

        document.querySelectorAll('.btn-resp').forEach(function(botao) {
            botao.addEventListener('click', function() {
                const id = botao.getAttribute('data-comentario-id');
                const caixa = document.getElementById('resposta-' + id);
                caixa.classList.toggle('aberto');
                if (caixa.classList.contains('aberto')) {
                    caixa.querySelector('textarea').focus();
                }
            });
        });

        /* ---------- Abrir/fechar e enviar caixa de resposta (reutilizável para comentários antigos e novos) ---------- */
        function ativarCaixaResposta(caixa) {
            if (caixa.dataset.ativado === 'true') return;
            caixa.dataset.ativado = 'true';

            const comentarioId = caixa.id.replace('resposta-', '');
            const textarea = caixa.querySelector('textarea');
            const botaoEnviar = caixa.querySelector('.btn-enviar-resposta');

            textarea.addEventListener('input', function() {
                botaoEnviar.disabled = textarea.value.trim().length === 0;
            });

            botaoEnviar.addEventListener('click', function() {
                const texto = textarea.value.trim();
                enviarComentario(POSTAGEM_ID, texto, comentarioId, function() {
                    textarea.value = '';
                    botaoEnviar.disabled = true;
                    caixa.classList.remove('aberto');

                    // Atualiza o contador "Respostas (N)" (cria o botão se for a primeira resposta)
                    const card = caixa.closest('.comentario-card');
                    let btnVer = card.querySelector('.btn-ver-respostas');
                    if (btnVer) {
                        const totalAtual = parseInt(btnVer.textContent.match(/\d+/)[0], 10);
                        btnVer.textContent = 'Respostas (' + (totalAtual + 1) + ')';
                    } else {
                        const btnResp = card.querySelector('.btn-resp');
                        btnVer = document.createElement('button');
                        btnVer.type = 'button';
                        btnVer.className = 'btn-ver-respostas';
                        btnVer.setAttribute('data-comentario-id', comentarioId);
                        btnVer.textContent = 'Respostas (1)';
                        btnResp.insertAdjacentElement('afterend', btnVer);
                        ativarBotaoVerRespostas(btnVer);
                    }

                    // Busca a lista atualizada do servidor (garante IDs reais para curtir/denunciar)
                    const lista = document.getElementById('lista-respostas-' + comentarioId);
                    lista.dataset.carregado = 'false';
                    lista.innerHTML = '';
                    carregarRespostas(comentarioId, lista, true);
                });
            });
        }

        function carregarRespostas(comentarioId, lista, abrirAposCarregar) {
            lista.innerHTML = '<div class="carregando-respostas">Carregando respostas...</div>';

            fetch('/responsavel/respostas/' + comentarioId)
                .then(res => res.json())
                .then(data => {
                    if (!data.sucesso) {
                        lista.innerHTML = '<div class="carregando-respostas">Erro ao carregar respostas.</div>';
                        return;
                    }
                    lista.innerHTML = '';
                    data.respostas.forEach(function(resposta) {
                        lista.innerHTML += montarHtmlResposta(resposta);
                    });
                    lista.dataset.carregado = 'true';
                    ativarAcoesIcones(lista);
                    if (abrirAposCarregar) lista.classList.add('aberto');
                })
                .catch(() => {
                    lista.innerHTML = '<div class="carregando-respostas">Erro de conexão.</div>';
                });
        }

        /* ---------- Ver/ocultar respostas de um comentário ---------- */
        function ativarBotaoVerRespostas(botao) {
            botao.addEventListener('click', function() {
                const comentarioId = botao.getAttribute('data-comentario-id');
                const lista = document.getElementById('lista-respostas-' + comentarioId);

                // Se já carregou antes, só alterna mostrar/ocultar
                if (lista.dataset.carregado === 'true') {
                    lista.classList.toggle('aberto');
                    return;
                }

                carregarRespostas(comentarioId, lista, true);
            });
        }

        document.querySelectorAll('.btn-ver-respostas').forEach(ativarBotaoVerRespostas);

        function montarHtmlResposta(resposta) {
            const avatar = resposta.foto_perfil || FOTO_PADRAO;
            const curtidoClasse = resposta.usuario_curtiu > 0 ? 'curtido' : '';
            const contador = resposta.total_curtidas > 0 ? resposta.total_curtidas : '';
            const btnExcluir = resposta.pode_excluir
                ? `<button type="button" class="acao-icone btn-excluir-comentario" data-id="${resposta.id}" title="Excluir">
                       <i class="fas fa-trash"></i>
                   </button>`
                : (USUARIO_LOGADO_ADMIN
                    ? `<button type="button" class="acao-icone btn-excluir-comentario-admin" data-id="${resposta.id}" title="Excluir (Admin)" style="color: #e74c3c;">
                           <i class="fas fa-trash"></i>
                       </button>`
                    : '');
            return `
                <div class="resposta-card" id="comentario-card-${resposta.id}">
                    <img src="${avatar}" class="avatar-img" alt="Avatar">
                    <div class="comentario-corpo">
                        <strong><a href="/responsavel/perfil/${resposta.usuario_id}" style="color: inherit; text-decoration: none;">${escapeHtml(resposta.nome_exibicao)}</a></strong>
                        <p>${escapeHtml(resposta.texto_comentario)}</p>
                        <div class="comentario-acoes">
                            <button type="button" class="acao-icone btn-denunciar" data-id="${resposta.id}" data-tipo="comentario" title="Denunciar">
                                <i class="fas fa-exclamation-triangle"></i>
                            </button>
                            <button type="button" class="acao-icone btn-curtir ${curtidoClasse}" data-id="${resposta.id}" data-tipo="comentario" title="Curtir">
                                <i class="fas fa-heart"></i>
                                <span class="contador-curtidas">${contador}</span>
                            </button>
                            ${btnExcluir}
                        </div>
                    </div>
                </div>
            `;
        }

        function escapeHtml(texto) {
            const div = document.createElement('div');
            div.textContent = texto;
            return div.innerHTML;
        }

        // Remove um comentário/resposta da tela e atualiza o contador "Respostas (N)" do pai, se houver
        function removerCardComentario(id) {
            const card = document.getElementById('comentario-card-' + id);
            if (!card) return;

            const listaPai = card.closest('.lista-respostas');
            if (listaPai) {
                const idComentarioPai = listaPai.id.replace('lista-respostas-', '');
                const cardPai = document.getElementById('comentario-card-' + idComentarioPai);
                const btnVer = cardPai ? cardPai.querySelector('.btn-ver-respostas') : null;
                if (btnVer) {
                    const match = btnVer.textContent.match(/\d+/);
                    const totalAtual = match ? parseInt(match[0], 10) : 1;
                    const novoTotal = Math.max(0, totalAtual - 1);
                    if (novoTotal === 0) {
                        btnVer.remove();
                    } else {
                        btnVer.textContent = 'Respostas (' + novoTotal + ')';
                    }
                }
            }

            card.remove();
        }

        /* ---------- Curtir / Denunciar / Excluir (funciona em comentários e respostas carregadas dinamicamente) ---------- */
        function ativarAcoesIcones(escopo) {
            escopo.querySelectorAll('.btn-curtir').forEach(function(botao) {
                if (botao.dataset.ativado === 'true') return;
                botao.dataset.ativado = 'true';

                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');
                    const tipo = botao.getAttribute('data-tipo');

                    fetch('/responsavel/curtir/' + id, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ tipo: tipo })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.sucesso) {
                            mostrarToast('Não foi possível curtir.', false);
                            return;
                        }
                        const curtiu = data.acao === 'curtida';
                        botao.classList.toggle('curtido', curtiu);
                        const span = botao.querySelector('.contador-curtidas');
                        let total = parseInt(span.textContent || '0', 10);
                        total = curtiu ? total + 1 : Math.max(0, total - 1);
                        span.textContent = total > 0 ? total : '';
                    })
                    .catch(() => mostrarToast('Erro de conexão ao curtir.', false));
                });
            });

            escopo.querySelectorAll('.btn-denunciar').forEach(function(botao) {
                if (botao.dataset.ativado === 'true') return;
                botao.dataset.ativado = 'true';

                botao.addEventListener('click', function() {
                    idDenunciaAtual = botao.getAttribute('data-id');
                    tipoDenunciaAtual = botao.getAttribute('data-tipo');
                    openModal('modal-denuncia-comentario');
                });
            });

            /* ---------- Excluir comentário/resposta (autor do comentário ou dono da postagem) ---------- */
            escopo.querySelectorAll('.btn-excluir-comentario').forEach(function(botao) {
                if (botao.dataset.ativado === 'true') return;
                botao.dataset.ativado = 'true';

                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');

                    pedirConfirmacao('Excluir este comentário?', function() {
                        fetch('/responsavel/comentario/' + id, { method: 'DELETE' })
                            .then(res => res.json())
                            .then(data => {
                                if (!data.sucesso) {
                                    mostrarToast('Não foi possível excluir o comentário.', false);
                                    return;
                                }
                                removerCardComentario(id);
                                mostrarToast('Comentário excluído.', true);
                            })
                            .catch(() => mostrarToast('Erro de conexão ao excluir.', false));
                    });
                });
            });

            /* ---------- Excluir (Admin): funciona mesmo sem ser autor/dono da postagem ---------- */
            escopo.querySelectorAll('.btn-excluir-comentario-admin').forEach(function(botao) {
                if (botao.dataset.ativado === 'true') return;
                botao.dataset.ativado = 'true';

                botao.addEventListener('click', function() {
                    const id = botao.getAttribute('data-id');

                    pedirConfirmacao('Excluir este comentário permanentemente? (ação de administrador)', function() {
                        fetch('/admin/comentario/' + id, { method: 'DELETE' })
                            .then(res => res.json())
                            .then(data => {
                                if (!data.sucesso) {
                                    mostrarToast(data.mensagem || 'Não foi possível excluir o comentário.', false);
                                    return;
                                }
                                removerCardComentario(id);
                                mostrarToast(data.mensagem || 'Comentário excluído.', true);
                            })
                            .catch(() => mostrarToast('Erro de conexão ao excluir.', false));
                    });
                });
            });
        }

        // Ativa os ícones dos comentários raiz já renderizados pelo EJS
        ativarAcoesIcones(document);
    </script>
    <%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
