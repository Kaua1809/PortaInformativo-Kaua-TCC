<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesquisa</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">

</head>
<body>
    <header>
        <%- include('partials/menu') %>
        <%- include('partials/navbar') %>
    </header>

    <main>
        <% if (busca) { %>
            <p class="pesquisa-topo">
                Exibindo todos os resultados da busca por <strong>"<%= busca %>"</strong>
            </p>
        <% } %>

        <div class="resultado-lista">

            <% if (!busca) { %>
                <div class="sem-resultado">
                    <div class="icone">🔍</div>
                    <p>Digite algo para pesquisar.</p>
                </div>

            <% } else if (resultados.length === 0 && relacionados.length === 0) { %>
                <div class="sem-resultado">
                    <div class="icone">😕</div>
                    <p>Nenhum resultado para <strong>"<%= busca %>"</strong>.</p>
                    <p style="font-size:0.88rem; color:#bbb;">Tente palavras diferentes ou termos mais curtos.</p>
                </div>

            <% } else { %>

                <% if (resultados.length > 0) { %>
                    <% resultados.forEach(function(noticia) { %>
                        <a href="/noticias/<%= noticia.id %>" class="card-resultado">
                            <% if (noticia.tem_foto) { %>
                                <img class="card-resultado-foto"
                                     src="/noticias/<%= noticia.id %>/foto"
                                     alt="<%= noticia.titulo %>">
                            <% } else { %>
                                <div class="card-resultado-foto-placeholder">📰</div>
                            <% } %>
                            <div class="card-resultado-info">
                                <div class="card-resultado-titulo"><%= noticia.titulo %></div>
                                <% if (noticia.descricao) { %>
                                    <div class="card-resultado-desc"><%= noticia.descricao %></div>
                                <% } %>
                                <div class="card-resultado-meta">
                                    <% if (noticia.autor_login) { %>Por <%= noticia.autor_login %> · <% } %>
                                    <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                <% } %>

                <% if (relacionados.length > 0) { %>
                    <div class="secao-relacionados">
                        <p class="secao-titulo">Você também pode se interessar</p>
                        <% relacionados.forEach(function(noticia) { %>
                            <a href="/noticias/<%= noticia.id %>" class="card-resultado">
                                <% if (noticia.tem_foto) { %>
                                    <img class="card-resultado-foto"
                                         src="/noticias/<%= noticia.id %>/foto"
                                         alt="<%= noticia.titulo %>">
                                <% } else { %>
                                    <div class="card-resultado-foto-placeholder">📰</div>
                                <% } %>
                                <div class="card-resultado-info">
                                    <div class="card-resultado-titulo">
                                        <%= noticia.titulo %>
                                        <span class="badge-relacionado">relacionado</span>
                                    </div>
                                    <% if (noticia.descricao) { %>
                                        <div class="card-resultado-desc"><%= noticia.descricao %></div>
                                    <% } %>
                                    <div class="card-resultado-meta">
                                        <% if (noticia.autor_login) { %>Por <%= noticia.autor_login %> · <% } %>
                                        <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% } %>

            <% } %>
        </div>
    </main>

    <%- include('partials/modal-contato') %>
    <%- include('partials/modal-feedback') %>
    <%- include('partials/rodape') %>
    <%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/menu.js"></script>
    <script src="/javascripts/modal-contato.js"></script>
    <script src="/javascripts/modal-feedback.js"></script>
</body>
</html>
