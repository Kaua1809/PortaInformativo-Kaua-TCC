<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesquisa</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
       <link rel="stylesheet" href="/stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
    <link rel="stylesheet" href="/stylesheets/conta.css">

</head>
<body>
    <header>
        <%- include('partials/menu') %>
        <%- include('partials/navbar') %>
    </header>

    <main>
        <% if (busca) { %>
            <p class="pesquisa-topo">
                Exibindo todos os resultados da busca por <strong>"<%= busca %>"</strong>
            </p>

            <div class="section-divider">
                <span id="tab-noticias" class="active">Notícias</span>
                <span id="tab-contas">Contas <% if (usuarios && usuarios.length > 0) { %>(<%= usuarios.length %>)<% } %></span>
            </div>
        <% } %>

        <!-- ================= ABA: NOTÍCIAS ================= -->
        <div class="resultado-lista" id="sec-noticias">

            <% if (!busca) { %>
                <div class="sem-resultado">
                    <div class="icone">🔍</div>
                    <p>Digite algo para pesquisar.</p>
                </div>

            <% } else if (resultados.length === 0 && relacionados.length === 0) { %>
                <div class="sem-resultado">
                    <div class="icone">😕</div>
                    <p>Nenhum resultado para <strong>"<%= busca %>"</strong>.</p>
                    <p style="font-size:0.88rem; color:#bbb;">Tente palavras diferentes ou termos mais curtos.</p>
                </div>

            <% } else { %>

                <% if (resultados.length > 0) { %>
                    <% resultados.forEach(function(noticia) { %>
                        <a href="/noticias/<%= noticia.id %>" class="card-resultado">
                            <% if (noticia.tem_foto) { %>
                                <img class="card-resultado-foto"
                                     src="/noticias/<%= noticia.id %>/foto"
                                     alt="<%= noticia.titulo %>">
                            <% } else { %>
                                <div class="card-resultado-foto-placeholder">📰</div>
                            <% } %>
                            <div class="card-resultado-info">
                                <div class="card-resultado-titulo"><%= noticia.titulo %></div>
                                <% if (noticia.descricao) { %>
                                    <div class="card-resultado-desc"><%= noticia.descricao %></div>
                                <% } %>
                                <div class="card-resultado-meta">
                                    <% if (noticia.autor_login) { %>Por <%= noticia.autor_login %> · <% } %>
                                    <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                <% } %>

                <% if (relacionados.length > 0) { %>
                    <div class="secao-relacionados">
                        <p class="secao-titulo">Você também pode se interessar</p>
                        <% relacionados.forEach(function(noticia) { %>
                            <a href="/noticias/<%= noticia.id %>" class="card-resultado">
                                <% if (noticia.tem_foto) { %>
                                    <img class="card-resultado-foto"
                                         src="/noticias/<%= noticia.id %>/foto"
                                         alt="<%= noticia.titulo %>">
                                <% } else { %>
                                    <div class="card-resultado-foto-placeholder">📰</div>
                                <% } %>
                                <div class="card-resultado-info">
                                    <div class="card-resultado-titulo">
                                        <%= noticia.titulo %>
                                        <span class="badge-relacionado">relacionado</span>
                                    </div>
                                    <% if (noticia.descricao) { %>
                                        <div class="card-resultado-desc"><%= noticia.descricao %></div>
                                    <% } %>
                                    <div class="card-resultado-meta">
                                        <% if (noticia.autor_login) { %>Por <%= noticia.autor_login %> · <% } %>
                                        <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% } %>

            <% } %>
        </div>

        <!-- ================= ABA: CONTAS ================= -->
        <div class="resultado-lista" id="sec-contas" style="display: none;">
            <% if (!busca) { %>
                <div class="sem-resultado">
                    <div class="icone">🔍</div>
                    <p>Digite algo para pesquisar.</p>
                </div>
            <% } else if (!usuarios || usuarios.length === 0) { %>
                <div class="sem-resultado">
                    <div class="icone">😕</div>
                    <p>Nenhuma conta encontrada para <strong>"<%= busca %>"</strong>.</p>
                </div>
            <% } else { %>
                <% usuarios.forEach(function(usuario) { %>
                    <a href="/responsavel/perfil/<%= usuario.id %>" class="card-resultado card-resultado-usuario">
                        <img class="card-resultado-avatar"
                             src="<%= usuario.foto_perfil || FOTO_PADRAO %>"
                             alt="<%= usuario.nome_exibicao %>">
                        <div class="card-resultado-info">
                            <div class="card-resultado-titulo"><%= usuario.nome_exibicao %></div>
                            <div class="card-resultado-meta">@<%= usuario.login %></div>
                            <% if (usuario.bio) { %>
                                <div class="card-resultado-desc"><%= usuario.bio %></div>
                            <% } %>
                        </div>
                    </a>
                <% }); %>
            <% } %>
        </div>
    </main>

    <%- include('partials/modal-contato') %>
    <%- include('partials/modal-feedback') %>
    <%- include('partials/rodape') %>
    <%- include('partials/script-acessibilidade') %>

    <script>
        const tabNoticias = document.getElementById('tab-noticias');
        const tabContas = document.getElementById('tab-contas');
        const secNoticias = document.getElementById('sec-noticias');
        const secContas = document.getElementById('sec-contas');

        if (tabNoticias && tabContas) {
            tabNoticias.onclick = function() {
                tabNoticias.classList.add('active');
                tabContas.classList.remove('active');
                secNoticias.style.display = 'block';
                secContas.style.display = 'none';
            };
            tabContas.onclick = function() {
                tabContas.classList.add('active');
                tabNoticias.classList.remove('active');
                secContas.style.display = 'block';
                secNoticias.style.display = 'none';
            };
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/menu.js"></script>
    <script src="/javascripts/modal-contato.js"></script>
    <script src="/javascripts/modal-feedback.js"></script>
</body>
</html>