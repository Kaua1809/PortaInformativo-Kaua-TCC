<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Portal do Responsável</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="stylesheets/style.css">
       <link rel="stylesheet" href="stylesheets/acessibilidade.css">
    <link rel="stylesheet" href="stylesheets/auth.css">
    <link rel="stylesheet" href="/stylesheets/modals.css">
</head>
<body>
<div class="auth-container">
    <div class="auth-header"><h1>BEM-VINDO DE VOLTA</h1></div>
    <div class="auth-content">
        <div class="auth-box">
            <p class="auth-subtitle">Faça login para acessar o portal</p>

            <!-- EXIBIÇÃO DE ERRO -->
            <% if (typeof erro !== 'undefined' && erro ) { %>
                <div class="alert alert-danger" role="alert"><%= erro %></div>
            <% } %>

            <form class="auth-form" method="POST" action="/login">
                <!-- NOME DE USUÁRIO -->
                <div class="form-group mb-3">
                    <label for="login" class="form-label">Nome de Usuário</label>
                    <input type="text" id="login" name="login" class="form-control form-input" placeholder="Seu nome de usuário" required>
                </div>

                <!-- SENHA COM BOTÃO DE VER -->
                <div class="form-group mb-3">
                    <label for="senha" class="form-label">Senha</label>
                    <div class="input-group">
                        <input type="password" id="senha" name="senha" class="form-control form-input" placeholder="Digite sua senha" required>
                        <button class="btn btn-outline-secondary" type="button" id="btn-senha" onclick="togglePassword()">
                            <i id="eye-icon" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-remember mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <input type="checkbox" id="lembrar" name="lembrar">
                        <label for="lembrar">Lembrar-me</label>
                    </div>
                    <a href="#" onclick="openModal('modal-esqueci-senha'); return false;" style="font-size: 0.9rem;">Esqueceu sua senha?</a>
                </div>

                <button type="submit" class="btn-auth btn-auth-primary w-100">Entrar</button>
            </form>

            <div class="auth-divider my-3"></div>
            <p class="auth-link">Não tem conta? <a href="/cadastro">Cadastre-se aqui</a></p>
        </div>
    </div>
</div>

<!-- Modal: Esqueci minha senha (mesmo padrão visual do modal de Contato/Feedback) -->
<div id="modal-esqueci-senha" class="modal-container">
    <div class="modal-box" style="max-width: 420px;">

        <h1><i class="bi bi-key"></i> Esqueceu sua senha?</h1>

        <p>Digite seu nome de usuário. Enviaremos um link de redefinição para o e-mail cadastrado nessa conta.</p>

        <div id="esqueci-senha-mensagem" style="display:none; margin-bottom: 15px; padding: 10px; border-radius: 6px; font-size: 0.9rem;"></div>

        <div class="campo-contato">
            <label class="label-contato" for="esqueci-senha-login">Nome de Usuário:</label>
            <input class="input-contato" type="text" id="esqueci-senha-login" required>
        </div>

        <div class="modal-footer">
            <button class="enviar" id="btn-enviar-esqueci-senha" type="button">Enviar Link</button>
            <button class="fechar" id="fechar" type="button">Fechar</button>
        </div>

    </div>
</div>

<script>
    function togglePassword() {
        const senhaInput = document.getElementById('senha');
        const eyeIcon = document.getElementById('eye-icon');
        if (senhaInput.type === 'password') {
            senhaInput.type = 'text';
            eyeIcon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            senhaInput.type = 'password';
            eyeIcon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

        document.getElementById('btn-enviar-esqueci-senha').addEventListener('click', function() {
        const login = document.getElementById('esqueci-senha-login').value.trim();
        const mensagemDiv = document.getElementById('esqueci-senha-mensagem');

        if (!login) {
            mensagemDiv.style.display = 'block';
            mensagemDiv.style.background = '#fdecea';
            mensagemDiv.style.color = '#c0392b';
            mensagemDiv.textContent = 'Digite seu nome de usuário.';
            return;
        }

        fetch('/login/esqueci-senha', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login })
        })
        .then(res => res.json())
        .then(data => {
            mensagemDiv.style.display = 'block';
            mensagemDiv.style.background = data.sucesso ? '#e6f4ea' : '#fdecea';
            mensagemDiv.style.color = data.sucesso ? '#1e7e34' : '#c0392b';
            mensagemDiv.textContent = data.mensagem;
        })
        .catch(() => {
            mensagemDiv.style.display = 'block';
            mensagemDiv.style.background = '#fdecea';
            mensagemDiv.style.color = '#c0392b';
            mensagemDiv.textContent = 'Erro de conexão. Tente novamente.';
        });
    });
</script>
<script src="/javascripts/modal-contato.js"></script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
