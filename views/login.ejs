<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Portal do Responsável</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="stylesheets/style.css">
    <link rel="stylesheet" href="stylesheets/auth.css">
</head>
<body>
<div class="auth-container">
    <div class="auth-header"><h1>BEM-VINDO DE VOLTA</h1></div>
    <div class="auth-content">
        <div class="auth-box">
            <p class="auth-subtitle">Faça login para acessar o portal</p>

            <!-- EXIBIÇÃO DE ERRO -->
            <% if (typeof erro !== 'undefined' && erro ) { %>
                <div class="alert alert-danger" role="alert"><%= erro %></div>
            <% } %>

            <form class="auth-form" method="POST" action="/login">
                <!-- NOME DE USUÁRIO -->
                <div class="form-group mb-3">
                    <label for="login" class="form-label">Nome de Usuário</label>
                    <input type="text" id="login" name="login" class="form-control form-input" placeholder="Seu nome de usuário" required>
                </div>

                <!-- SENHA COM BOTÃO DE VER -->
                <div class="form-group mb-3">
                    <label for="senha" class="form-label">Senha</label>
                    <div class="input-group">
                        <input type="password" id="senha" name="senha" class="form-control form-input" placeholder="Digite sua senha" required>
                        <button class="btn btn-outline-secondary" type="button" id="btn-senha" onclick="togglePassword()">
                            <i id="eye-icon" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-remember mb-3">
                    <input type="checkbox" id="lembrar" name="lembrar">
                    <label for="lembrar">Lembrar-me</label>
                </div>

                <button type="submit" class="btn-auth btn-auth-primary w-100">Entrar</button>
            </form>

            <div class="auth-divider my-3"></div>
            <p class="auth-link">Não tem conta? <a href="/cadastro">Cadastre-se aqui</a></p>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const senhaInput = document.getElementById('senha');
        const eyeIcon = document.getElementById('eye-icon');
        if (senhaInput.type === 'password') {
            senhaInput.type = 'text';
            eyeIcon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            senhaInput.type = 'password';
            eyeIcon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
</script>
<%- include('partials/script-acessibilidade') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
